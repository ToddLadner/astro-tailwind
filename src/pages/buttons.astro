---
import Layout from '../layouts/Layout.astro';
import Button from '@components/Button.astro';

const { 
	title = "My Astro Blog",
	description = "My musings about the Astro framework",
	...rest 
} = Astro.props;
---
<style>
  [data-icon="skull"] {
    mask: url(./favicon.svg) center / contain no-repeat;
  }
  [data-icon] {
    background: conic-gradient(
      from -90deg at 25% 115%,
      #ff0000,
      #ff0066,
      #ff00cc,
      #cc00ff,
      #6600ff,
      #0000ff,
      #0000ff,
      #0000ff,
      #0000ff
    );
  }

[data-icon="skull-mask"] {
  mask: url(./favicon.svg) center / contain no-repeat;
  -webkit-mask: url(./favicon.svg) center / contain no-repeat;
}
</style>

<svg width="0" height="0" style="position: absolute;">
  <mask id="skullmask">
    <path
      d="M41.747 0.416992C19.476 0.416992 1.31198 16.856 0.336978 37.477C0.305978 37.628 0.289978 37.785 0.289978 37.944V39.811H6.67498V53.172H0.289978L4.12498 71.541V83.75C4.12498 84.577 4.79698 85.248 5.62498 85.248C6.45198 85.248 7.12398 84.577 7.12398 83.75V81.833H8.51998V83.75C8.51998 84.577 9.19098 85.248 10.019 85.248C10.848 85.248 11.519 84.577 11.519 83.75V81.833H12.915V83.75C12.915 84.577 13.585 85.248 14.414 85.248C15.243 85.248 15.914 84.577 15.914 83.75V81.833H17.31V83.75C17.31 84.577 17.98 85.248 18.809 85.248C19.638 85.248 20.309 84.577 20.309 83.75V81.833H21.704V83.75C21.704 84.577 22.375 85.248 23.204 85.248C24.033 85.248 24.704 84.577 24.704 83.75V81.833H28.982C29.738 81.833 30.404 81.475 30.839 80.928C31.046 80.668 31.2 80.369 31.281 80.038C34.335 74.511 40.405 77.722 47.424 77.644C67.631 75.052 83.203 58.848 83.203 39.221C83.205 17.79 64.643 0.416992 41.747 0.416992ZM5.04198 61.097L8.75598 54.662L12.471 48.229L16.185 54.662L19.9 61.097H5.04198ZM25.636 53.466C21.783 53.466 18.66 50.344 18.66 46.492C18.66 42.639 21.783 39.516 25.636 39.516C29.488 39.516 32.611 42.64 32.611 46.492C32.611 50.344 29.488 53.466 25.636 53.466Z"
      fill="white"
    />
  </mask>
</svg>

<Layout {title} {description}>
	<main class='bg-surface-2'>
    <div 
      style="width: 164px; aspect-ratio: 1;"
      data-icon="skull"
    ></div>

    <div 
      style="width: 164px; aspect-ratio: 1;"
      data-icon="skull-mask"
    ></div>
    <article class="px-max py-2xl stack-md">
       <h1>Buttons</h1>
      <p class="text-md leading-lg">Easily create nice looking buttons, which come in different sizes, shapes, and styles.</p>
      <Button text='Default' />
      
      <Button 
        theme='outlined' 
        text='Outlined'
        elevated="shadow-xs"
      />
      
      <Button 
        theme='tonal' 
        text='Tonal'
        elevated="shadow-sm"
      />
      
      <Button 
        theme='filled' 
        text='Filled'
        elevated="shadow-md"
      />
      
      <Button 
        theme='custom' 
        text='custom'
        elevated="shadow-lg"
      />
      
      <Button 
        href="google.com"
        theme="filled"
        text='Link' 
      />

      <Button 
       type="submit"
        theme="filled"
        text='Link' 
      />

      <hr>

      <h3>Icon Buttons</h3>
      
      <Button 
        variant='icon-button' 
        icon='symbols-solid'
        aria-label='default btn text'
      />

      <Button 
        theme='outlined' 
        variant='icon-button' 
        icon='symbols-solid'
        aria-label='outlined btn text'
      />

      <Button
        theme='tonal'
        variant='icon-button'
        icon='symbols-solid'
        aria-label='tonal btn text'
      />
      
      <Button 
        theme="filled" 
        variant='icon-button' 
        icon='symbols-solid' 
        aria-label='filled btn text'
      />
      
      <Button 
        theme="custom" 
        variant='icon-button' 
        icon='symbols-solid' 
        aria-label='custom btn text'
        shape='circle'
      />

      <Button 
        theme="custom" 
        variant='icon-button' 
        icon='symbols-solid' 
        aria-label='custom'
        shape='circle'
        size='lg'
      />
      
      <h3>With icons</h3>
      
      <Button 
        icon='symbols-solid'
        text='Default'
      />

      <Button 
        theme='outlined' 
        icon='symbols-solid'
        text='outlined'
      />

      <Button
        theme='tonal'
        icon='symbols-solid'
        text='tonal'
      />
      
      <Button 
        theme="filled" 
        icon='symbols-solid' 
        text='filled'
      />
      
      <Button 
        theme="custom" 
        icon='symbols-solid' 
        text='custom'
        dir='rtl'
      />

      <hr>
      
      <h3>Disabled Buttons</h3>
      
      <Button 
        text='Default' 
        disabled
      />
      <Button 
        theme='outlined' 
        text='Outlined' 
        disabled 
      />
      <Button 
        theme='tonal' 
        text='Tonal' 
        disabled 
      />
      <Button 
        theme='filled' 
        text='Filled' 
        disabled 
      />
      <Button 
        theme='custom' 
        text='custom'
        disabled 
      />

      <hr />

      <Button 
        icon='symbols-solid' 
        text='Default' 
        disabled
      />
      <Button
        icon='symbols-solid' 
        theme='outlined' 
        text='Outlined' 
        disabled 
      />
      <Button 
        icon='symbols-solid'
        theme='tonal' 
        text='Tonal' 
        disabled 
      />
      <Button
        icon='symbols-solid' 
        theme='filled' 
        text='Filled' 
        disabled 
      />
      <Button
        icon='symbols-solid'  
        theme='custom' 
        text='custom'
        disabled 
      />

      <h3>Shapes</h3>
      
      <Button 
        theme='outlined' 
        text='Pill Shape'
        shape='pill'
      />
      
      <Button 
        theme='tonal' 
        text='Square shape'
        shape='square'
      />
      
      <Button 
        theme='filled'
        shape='circle'
        text='Ci'
        variant='icon-button'
      />

      <Button 
        theme='tonal' 
        text='Squircle shape'
        shape='squircle'
      />

      <Button 
        theme='tonal' 
        text='superellipse shape'
        shape='superellipse'
      />

      <h2>Sizes</h2>
      <Button 
        theme='tonal' 
        text='Small'
        size='sm'
      />

       <Button 
        theme='tonal' 
        text='Tonal'
      /> 

      <Button 
        theme='tonal' 
        text='Tonal'
        size='lg'
      />

      <h2>Spring</h2>    
      <Button 
        theme='tonal' 
        text='Press me'
        size='lg'
        classes="spring"
      />
    </article>
  </main>
</Layout>