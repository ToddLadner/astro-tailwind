---
import Button from "@components/Button.astro";
import ComponentDocPage from "@components/docs/ComponentDocPage.astro";
import ComponentExample from "@components/docs/ComponentExample.astro";
import ExampleGroup from "@components/docs/ExampleGroup.astro";
import Layout from "@layouts/Layout.astro";
import { buttonDoc } from "../docs/components/button";

const {
	title = "Buttons | Astro Tailwind",
	description = "Button component variants, accessibility guidance, responsive behavior, and Astro examples",
	...rest
} = Astro.props;
---

<Layout {title} {description} {...rest}>
	<main class="bg-surface-2">
		<ComponentDocPage doc={buttonDoc}>
			{buttonDoc.groups.map((group) => (
				<ExampleGroup group={group}>
					{group.examples.map((example) => (
						<ComponentExample example={example}>
							<Fragment slot="preview">
								<Button {...example.props} />
							</Fragment>
						</ComponentExample>
					))}
				</ExampleGroup>
			))}
		</ComponentDocPage>
	</main>
</Layout>
