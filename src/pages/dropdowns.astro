---
import Layout from '@layouts/Layout.astro';
import Button from '@components/Button.astro';
import Dropdown from '@components/Dropdown.astro';
import MenuItem from "@components/MenuItem.astro";

import userAvatar from '@images/killer-mike.jpg';
import altUserAvatar from '@images/elp.jpg';

const { 
	title = "My Astro Blog",
	description = "My musings about the Astro framework",
	...rest 
} = Astro.props;
---


<Layout {title} {description}>
  <main class="bg-surface-2 stack">
    <!-- Header -->
    <article class="px-max py-2xl stack-md grid place-content-center">
      <h1>Dropdown</h1>
      <p class="text-md leading-lg">The Popover API provides developers with a standard, consistent, flexible mechanism for displaying popover content on top of other page content. Popover content can be controlled either declaratively using HTML attributes, or via JavaScript.</p>
    <div class="flex ">

</div>

  <Dropdown
    id="settings"
    label="Open settings menu"
    triggerProps={{ theme: "filled", variant: "icon-button", icon: "magnifying-glass-solid"  }}
  >
    <MenuItem itemProps={{ text: "Profile" }} />
    <MenuItem itemProps={{ text: "Notifications" }} />
    <MenuItem itemProps={{ text: "Sign out", disabled: true }} />
    <MenuItem href="/account" itemProps={{ text: "Account", theme: "tonal" }} />
  </Dropdown>
</article>


  </main>
</Layout>

<script is:inline>


// Wait for the element to be in the DOM
const anchor = document.getElementById('anchor');
let isDragging = false;
let offsetX, offsetY;

anchor.addEventListener('mousedown', (e) => {
  isDragging = true;
  
  // Calculate offset between cursor and element's top-left corner
  const rect = anchor.getBoundingClientRect();
  offsetX = e.clientX - rect.left;
  offsetY = e.clientY - rect.top;
  
  anchor.style.cursor = 'grabbing';
});

document.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  
  anchor.style.left = (e.clientX - offsetX) + 'px';
  anchor.style.top = (e.clientY - offsetY) + 'px';
});

document.addEventListener('mouseup', () => {
  isDragging = false;
  anchor.style.cursor = 'move';
});
</script>

