---
import Layout from '@layouts/Layout.astro';
import Dialog from '@components/Dialog.astro';
import Button from '@components/Button.astro';
import Dropdown from '@components/Dropdown.astro';
import Tooltip from '@components/Tooltip.astro';
import Avatar from '@components/Avatar.astro';

import userAvatar from '@images/killer-mike.jpg';
import altUserAvatar from '@images/elp.jpg';

const { 
	title = "My Astro Blog",
	description = "My musings about the Astro framework",
	...rest 
} = Astro.props;
---

<style>
  @supports (position-area: top) {
  :is(html, dialog)::after {
    content: "";
    position: fixed;
    position-anchor: --focus;
    inset: anchor(inside,0);
    outline: 2px solid var(--color-brand-4);
    outline-offset: 3px;
    border-radius: 2px;
    pointer-events: none;
    transition: .4s;
  }
  *:focus-visible {
    outline: none;
    anchor-name: --focus;
  }
}

  /* Click me */
#click-btn { anchor-name: --click-btn; }
  #click-menu {
    position-anchor: --click-btn, --focus;
    position-area: bottom center;
  }   

#click-btn:focus-visible {
  anchor-name: --click-btn, --focus;
}
 

  /**/
  #anchor-pos-1 {
    anchor-name: --anchor-pos-1;
  }
  #target-pos-1 {
    position-anchor: --anchor-pos-1;
    top: anchor(bottom);
    left: anchor(right);
    position: absolute;
    margin: 0;
  }
  /* */


#my-anchor-try-tactics-2 {
  anchor-name: --my-anchor-try-tactics-2;
  position: relative;
  top: 5rem;
  right:3rem;
}



#my-target-try-tactics-2 {
  position-anchor: --my-anchor-try-tactics-2;
}

#my-target-try-tactics,
#my-target-try-tactics-2 {
  margin:0;
  position: absolute;
  bottom: anchor(top);
  left: anchor(right);
  position-try-fallbacks: flip-block, flip-inline, flip-start;
}

