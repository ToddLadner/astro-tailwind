---
import "@styles/main.css";
import Layout from "@layouts/LayoutClaude.astro";
---

<Layout title="Messaging | TalkingParents" description="TalkingParents messaging">
	<a class="msg-skip" href="#main-content">Skip to main content</a>

	<div class="grid" x-data="{ view: 'messaging', coachView: 'welcome', activeChat: null, mobilePanel: 'threads' }">
		<!-- ── Global header ──────────────────────────────────── -->
		<header class="msg-header" aria-label="Global">
			<a href="/" class="msg-logo-link" aria-label="TalkingParents home">
				<svg width="150" height="36" viewBox="0 0 150 36" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path
						d="M24 2C15.16 2 8 9.16 8 18c0 4.2 1.64 8.02 4.32 10.88L10 32l4.8-1.6C16.84 31.42 18.36 32 20 32c8.84 0 16-7.16 16-16S28.84 2 20 2z"
						fill="#004739"
					/>
					<path
						d="M34 10c6.63 0 12 5.37 12 12s-5.37 12-12 12c-1.4 0-2.74-.24-4-.68L25.2 35l-2-3.28C20.84 30.2 20 27.2 20 24c0-7.73 6.27-14 14-14z"
						fill="#004739"
					/>
					<circle cx="17" cy="19" r="2" fill="#28b99a" />
					<circle cx="23" cy="19" r="2" fill="#28b99a" />
					<circle cx="29" cy="19" r="2" fill="#28b99a" />
					<text x="50" y="24" font-family="system-ui,sans-serif" font-size="15" font-weight="700" fill="#004739">
						TalkingParents
					</text>
				</svg>
			</a>

			<form class="msg-search" role="search" aria-label="Search messages">
				<label for="site-search" class="sr-only">Search</label>
				<svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
					<circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5" />
					<path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
				<input id="site-search" name="q" type="search" placeholder="Search messages">
				<kbd aria-label="Keyboard shortcut Command K">&#8984;K</kbd>
			</form>

			<div class="msg-header-actions" aria-label="App actions">
				<button type="button" class="msg-header-btn msg-header-btn--badge" aria-label="Notifications, 2 unread">
					<svg aria-hidden="true" width="18" height="20" viewBox="0 0 18 20" fill="none">
						<path
							d="M9 1a6 6 0 00-6 6v5L1.5 14h15L15 12V7A6 6 0 009 1z"
							stroke="currentColor"
							stroke-width="1.4"
							fill="none"
						/>
						<path d="M7 16a2 2 0 004 0" stroke="currentColor" stroke-width="1.4" fill="none" />
					</svg>
					<span class="msg-badge" aria-hidden="true">2</span>
				</button>
				<button type="button" class="msg-header-btn" aria-label="Download">
					<svg aria-hidden="true" width="18" height="19" viewBox="0 0 18 19" fill="none">
						<path
							d="M9 1v12M5 9l4 5 4-5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<path d="M1 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
					</svg>
				</button>
				<button type="button" class="msg-header-btn" aria-label="Upload">
					<svg aria-hidden="true" width="16" height="19" viewBox="0 0 16 19" fill="none">
						<path
							d="M8 14V2M4 6l4-5 4 5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<path d="M1 16h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
					</svg>
				</button>
			</div>
		</header>

		<!-- ── Sidebar ────────────────────────────────────────── -->
		<aside class="msg-sidebar" :class="{ 'msg-mobile-active': mobilePanel === 'sidebar' }">
			<nav aria-label="Primary navigation">
				<ul class="msg-nav-list">
					<li><a href="/dashboard" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" />
								<rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" />
								<rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" />
								<rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" />
							</svg>
						</span>
						Dashboard
					</a></li>
				</ul>

				<h2 class="msg-nav-group" id="nav-primary">Primary</h2>
				<ul class="msg-nav-list" aria-labelledby="nav-primary">
					<li><a href="/messaging" class="msg-nav-link" :aria-current="view === 'messaging' ? 'page' : undefined" @click.prevent="view = 'messaging'">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path
									d="M14 1H2C1.45 1 1 1.45 1 2v9c0 .55.45 1 1 1h2v3l3.6-3H14c.55 0 1-.45 1-1V2c0-.55-.45-1-1-1z"
									fill="currentColor"
								/>
								<circle cx="5" cy="6.5" r="1" fill="white" />
								<circle cx="8" cy="6.5" r="1" fill="white" />
								<circle cx="11" cy="6.5" r="1" fill="white" />
							</svg>
						</span>
						Messaging
					</a></li>
					<li><a href="/calling" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path
									d="M3.5 1C3.5 1 1 3.5 1 6.5C1 11.19 4.81 15 9.5 15C12.5 15 15 12.5 15 12.5L12.5 10L10.5 11.5C9 10.5 5.5 7 4.5 5.5L6 3.5L3.5 1Z"
									fill="currentColor"
								/>
							</svg>
						</span>
						Calling
					</a></li>
					<li><a href="/calendar" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect
									x="1"
									y="3"
									width="14"
									height="12"
									rx="1.5"
									stroke="currentColor"
									stroke-width="1.5"
									fill="none"
								/>
								<path d="M1 7h14" stroke="currentColor" stroke-width="1.5" />
								<path d="M5 1v4M11 1v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
							</svg>
						</span>
						Calendar
					</a></li>
					<li><a href="/payments" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect
									x="1"
									y="3"
									width="14"
									height="10"
									rx="1.5"
									stroke="currentColor"
									stroke-width="1.5"
									fill="none"
								/>
								<path d="M1 7h14" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</span>
						Payments
					</a></li>
					<li><a href="/info-library" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect x="2" y="1" width="9" height="13" rx="1" stroke="currentColor" stroke-width="1.4" fill="none" />
								<path d="M5 5h5M5 8h5M5 11h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
								<path d="M11 4h2a1 1 0 011 1v8a1 1 0 01-1 1H5" stroke="currentColor" stroke-width="1.2" />
							</svg>
						</span>
						Info Library
					</a></li>
					<li><a href="/records" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect x="3" y="3" width="10" height="12" rx="1" stroke="currentColor" stroke-width="1.4" fill="none" />
								<rect x="1" y="1" width="10" height="12" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
								<path d="M4 6h5M4 8.5h5M4 11h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
							</svg>
						</span>
						Records
					</a></li>
					<li><a href="/journal" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect x="3" y="1" width="10" height="14" rx="1" stroke="currentColor" stroke-width="1.4" fill="none" />
								<path d="M3 4H2a1 1 0 00-1 1v6a1 1 0 001 1h1" stroke="currentColor" stroke-width="1.2" />
								<path d="M6 5h5M6 8h5M6 11h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
							</svg>
						</span>
						Journal
					</a></li>
					<li><a href="/vault" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<rect x="1" y="5" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" fill="none" />
								<path d="M5 5V4a3 3 0 016 0v1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
								<circle cx="8" cy="9.5" r="1.8" stroke="currentColor" stroke-width="1.2" fill="none" />
							</svg>
						</span>
						Vault
					</a></li>
				</ul>

				<h2 class="msg-nav-group" id="nav-coaching">Coaching</h2>
				<ul class="msg-nav-list" aria-labelledby="nav-coaching">
					<li><a href="/ai-coach" class="msg-nav-link" :aria-current="view === 'coach' ? 'page' : undefined" @click.prevent="view = 'coach'; coachView = coachView || 'welcome'">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path d="M8 1l1.5 4.5L14 7l-4.5 1.5L8 13l-1.5-4.5L2 7l4.5-1.5L8 1z" fill="currentColor" />
							</svg>
						</span>
						AI Coach
					</a></li>
					<li><a href="/co-parents" class="msg-nav-link">
						<span class="msg-nav-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<circle cx="6" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.3" fill="none" />
								<path
									d="M1 14c0-2.76 2.24-5 5-5s5 2.24 5 5"
									stroke="currentColor"
									stroke-width="1.3"
									stroke-linecap="round"
									fill="none"
								/>
								<circle cx="12.5" cy="5" r="2" stroke="currentColor" stroke-width="1.2" fill="none" />
								<path
									d="M12.5 10c1.93 0 3.5 1.34 3.5 3"
									stroke="currentColor"
									stroke-width="1.2"
									stroke-linecap="round"
									fill="none"
								/>
							</svg>
						</span>
						Co-parents
					</a></li>
				</ul>
			</nav>
		</aside>

		<!-- ── Main workspace: Messaging ──────────────────────── -->
		<main x-show="view === 'messaging'" id="main-content" class="msg-workspace">
			<!-- ── Thread list ──────────────────────────────── -->
			<section class="msg-threads-panel" :class="{ 'msg-mobile-active': mobilePanel === 'threads' }" aria-labelledby="threads-heading">
				<div class="msg-threads-toolbar">
					<h2 id="threads-heading" class="sr-only">Conversations</h2>
					<a href="/messaging/new" class="msg-btn-new">
						<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
							<path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
						</svg>
						New Message
					</a>
					<button type="button" class="msg-toolbar-btn" aria-label="Filter conversations">
						<svg aria-hidden="true" width="22" height="16" viewBox="0 0 22 16" fill="none">
							<path d="M1 2h20M4 8h14M7 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
						</svg>
					</button>
				</div>

				<ul class="msg-thread-list" aria-label="Conversation list" @click.prevent="mobilePanel = 'conv'">
					<li class="msg-thread msg-thread--unread"><a href="/messaging/thread/1">
						<span class="msg-thread-top">
							<span class="msg-thread-name">Robert Freeman</span>
							<time class="msg-thread-date" datetime="2026-03-07">Today</time>
						</span>
						<span class="msg-thread-bottom">
							<span class="msg-unread-dot"><span class="sr-only">Unread — </span></span>
							<span class="msg-thread-preview">New message received</span>
						</span>
					</a></li>

					<li class="msg-thread msg-thread--unread"><a href="/messaging/thread/2">
						<span class="msg-thread-top">
							<span class="msg-thread-name">Robert Freeman</span>
							<time class="msg-thread-date" datetime="2026-03-07">Today</time>
						</span>
						<span class="msg-thread-bottom">
							<span class="msg-unread-dot"><span class="sr-only">Unread — </span></span>
							<span class="msg-thread-preview">New message received</span>
						</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/3" aria-current="page">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">School pickup time talk</span>
							<time class="msg-thread-date" datetime="2026-03-06">Yesterday</time>
						</span>
						<span class="msg-thread-preview">I wanted to follow up on your last point. I...</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/4">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">Subject of the message</span>
							<time class="msg-thread-date" datetime="2026-03-06">Yesterday</time>
						</span>
						<span class="msg-thread-preview">I wanted to follow up on your last point. I agree.</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/5">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">Grades are getting better but we...</span>
							<time class="msg-thread-date" datetime="2026-02-25">2/25/26</time>
						</span>
						<span class="msg-thread-preview">Lets try and keep up this last point. wi...</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/6">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">What is the meaning of life</span>
							<time class="msg-thread-date" datetime="2026-02-24">2/24/26</time>
						</span>
						<span class="msg-thread-preview">When do you think we can talk about t...</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/7">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">42 is the answer to everything</span>
							<time class="msg-thread-date" datetime="2026-02-23">2/23/26</time>
						</span>
						<span class="msg-thread-preview">I wanted to follow up on your last point. I...</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/8">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">This is the next to last time</span>
							<time class="msg-thread-date" datetime="2026-02-23">2/23/26</time>
						</span>
						<span class="msg-thread-preview">I wanted to follow up on your last point. I...</span>
					</a></li>

					<li class="msg-thread"><a href="/messaging/thread/9">
						<span class="msg-thread-top">
							<span class="msg-thread-subject">Lets talk about the movie time</span>
							<time class="msg-thread-date" datetime="2026-02-22">2/22/26</time>
						</span>
						<span class="msg-thread-preview">I wanted to follow up on your last point. I...</span>
					</a></li>
				</ul>
			</section>

			<!-- ── Conversation ─────────────────────────────── -->
			<section class="msg-conv" :class="{ 'msg-mobile-active': mobilePanel === 'conv' }" aria-labelledby="conv-heading">
				<header class="msg-conv-header">
					<button type="button" class="msg-conv-back" aria-label="Back to conversations" @click="mobilePanel = 'threads'">
						<svg aria-hidden="true" width="11" height="16" viewBox="0 0 11 16" fill="none">
							<path
								d="M9 1.5L2 8l7 6.5"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
					<div class="msg-conv-avatar" aria-hidden="true">
						<svg width="44" height="44" viewBox="0 0 44 44">
							<circle cx="22" cy="22" r="22" fill="#c8dbd8" />
							<circle cx="22" cy="18" r="7" fill="#8ab5b0" />
							<ellipse cx="22" cy="37" rx="13" ry="9" fill="#8ab5b0" />
						</svg>
					</div>
					<div class="msg-conv-meta">
						<h2 id="conv-heading" class="msg-conv-name">Robert Freeman</h2>
						<p class="msg-conv-subtitle">
							Started: <time datetime="2026-03-07T12:32">Today at 12:32 PM</time>
						</p>
					</div>
					<div class="msg-conv-actions" aria-label="Conversation actions">
						<button type="button" class="msg-conv-btn" aria-label="Filter messages">
							<svg aria-hidden="true" width="22" height="16" viewBox="0 0 22 16" fill="none">
								<path d="M1 2h20M4 8h14M7 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
							</svg>
						</button>
						<button type="button" class="msg-conv-btn" aria-label="Notification settings">
							<svg aria-hidden="true" width="18" height="20" viewBox="0 0 18 20" fill="none">
								<path
									d="M9 1a6 6 0 00-6 6v5L1.5 14h15L15 12V7A6 6 0 009 1z"
									stroke="currentColor"
									stroke-width="1.4"
									fill="none"
								/>
								<path d="M7 16a2 2 0 004 0" stroke="currentColor" stroke-width="1.4" fill="none" />
							</svg>
						</button>
						<button type="button" class="msg-conv-btn" aria-label="Bookmark conversation">
							<svg aria-hidden="true" width="16" height="20" viewBox="0 0 16 20" fill="none">
								<path
									d="M2 1h12a1 1 0 011 1v16l-7-4-7 4V2a1 1 0 011-1z"
									stroke="currentColor"
									stroke-width="1.5"
									fill="none"
								/>
							</svg>
						</button>
						<button type="button" class="msg-conv-btn" aria-label="More options">
							<svg aria-hidden="true" width="18" height="5" viewBox="0 0 18 5" fill="none">
								<circle cx="2" cy="2.5" r="2" fill="currentColor" />
								<circle cx="9" cy="2.5" r="2" fill="currentColor" />
								<circle cx="16" cy="2.5" r="2" fill="currentColor" />
							</svg>
						</button>
					</div>
				</header>

				<div class="msg-conv-divider" role="separator"></div>

				<ol class="msg-log" aria-label="Message history" aria-live="polite">
					<li role="separator" class="msg-date-sep">
						<time datetime="2026-03-06">Yesterday</time>
					</li>

					<li class="msg-message msg-message--in">
						<article aria-labelledby="msg-1-author">
							<h3 id="msg-1-author" class="sr-only">Robert Freeman</h3>
							<div class="msg-bubble-body">
								<p>I'll add everything to Shared Calendar for you.</p>
								<a href="/attachments/pictures_of_the_kids.png" class="msg-attachment">
									<svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none">
										<path
											d="M15.5 8.5L8 16a5 5 0 01-7-7l8-8a3 3 0 014 4L5 13a1 1 0 01-1-1l6-6"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
										/>
									</svg>
									<span>
										<span class="msg-attachment-name">pictures_of_the_kids.png</span>
										<time class="msg-attachment-date" datetime="2023-05-07T12:15">5/7/2023, 12:15 PM</time>
									</span>
								</a>
							</div>
							<footer>
								<button type="button" class="msg-msg-menu" aria-label="Message options">
									<svg aria-hidden="true" width="18" height="5" viewBox="0 0 18 5" fill="none">
										<circle cx="2" cy="2.5" r="2" fill="currentColor" />
										<circle cx="9" cy="2.5" r="2" fill="currentColor" />
										<circle cx="16" cy="2.5" r="2" fill="currentColor" />
									</svg>
								</button>
							</footer>
						</article>
					</li>

					<li class="msg-message msg-message--in">
						<article aria-labelledby="msg-2-author">
							<h3 id="msg-2-author" class="sr-only">Robert Freeman — image</h3>
							<div class="msg-bubble-body msg-bubble-body--image">
								<svg aria-hidden="true" width="51" height="43" viewBox="0 0 51 43" fill="none">
									<rect
										x="1"
										y="1"
										width="49"
										height="41"
										rx="4"
										stroke="currentColor"
										stroke-width="1.5"
										fill="none"
									/>
									<circle cx="16" cy="14" r="5" stroke="currentColor" stroke-width="1.5" fill="none" />
									<path
										d="M1 30l13-12 10 10 8-7 18 12"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									/>
								</svg>
								<p>
									<strong class="msg-image-label">Image sent by Robert</strong>
									<br>
									<span class="msg-image-sub">Click to view</span>
								</p>
							</div>
						</article>
					</li>

