	<style is:global>
	/* ── Base ─────────────────────────────────────────────────── */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:root {
		--sidebar-min: 240px;
		--sidebar-max: 280px;
		--list-min: 320px;
		--list-max: 600px;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Design tokens ────────────────────────────────────────── */
	.grid {
		--c-app: #e4f0ee;
		--c-panel: #f2f7f6;
		--c-white: #ffffff;
		--c-teal: #11a78c;
		--c-dark: #01261f;
		--c-dark-green: #004739;
		--c-body: #3d615a;
		--c-muted: #6e7682;
		--c-yellow: #f4b740;
		--c-bubble-in: #e7efed;
		--c-bubble-out: #e2f3f0;
		--c-link: #24a086;
		--c-border: rgba(0, 71, 57, 0.08);
		--c-shadow: rgba(17, 167, 140, 0.12);

		display: grid;
		grid-template-columns:
			minmax(var(--sidebar-min), var(--sidebar-max))
			minmax(var(--list-min), var(--list-max))
			1fr;
		grid-template-rows: auto 1fr;
		height: 100dvh;
		gap: 24px;
		overflow: hidden;
		background: var(--c-app);
		color: var(--c-body);
	}

	/* ── Skip link ────────────────────────────────────────────── */
	.msg-skip {
		position: absolute;
		top: -100%;
		left: 8px;
		z-index: 100;
		padding: 8px 16px;
		background: var(--c-teal);
		color: white;
		border-radius: 0 0 6px 6px;
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
	}
	.msg-skip:focus {
		top: 0;
	}

	/* ── Header ───────────────────────────────────────────────── */
	.msg-header {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns:
			minmax(var(--sidebar-min), var(--sidebar-max)) /* aligns with aside */
			1fr /* search stretches  */
			auto; /* actions hugs      */
		align-items: center;
		height: 68px;
		padding-top: 24px;
		container-type: normal;
	}

	.msg-logo-link {
		grid-column: 1;
		display: flex;
		align-items: center;
		padding: 0 16px;
		text-decoration: none;
	}
	.msg-logo-link svg {
		display: block;
	}

	.msg-search {
		grid-column: 2 / 3;
		display: flex;
		align-items: center;
		gap: 10px;
		height: 44px;
		padding: 0 14px;
		background: rgba(0, 71, 57, 0.06);
		border: none;
		border-radius: 8px;
		color: var(--c-dark-green);
	}
	.msg-search input {
		flex: 1;
		border: none;
		background: transparent;
		font-size: 14px;
		color: var(--c-dark);
		outline: none;
	}
	.msg-search input::placeholder {
		color: var(--c-body);
		opacity: 0.55;
	}
	.msg-search kbd {
		font-size: 12px;
		font-weight: 500;
		color: var(--c-dark-green);
		opacity: 0.55;
		flex-shrink: 0;
	}

	.msg-header-actions {
		grid-column: 3;
		display: flex;
		align-items: center;
		gap: 6px;
		justify-content: flex-end;
		padding-right: 16px;
	}
	.msg-header-btn {
		position: relative;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.75);
		border: none;
		border-radius: 6px;
		color: var(--c-dark);
		cursor: pointer;
		transition: background 120ms;
	}
	.msg-header-btn:hover {
		background: var(--c-white);
	}

	.msg-badge {
		position: absolute;
		top: -5px;
		right: -5px;
		min-width: 18px;
		height: 18px;
		padding: 0 4px;
		background: var(--c-yellow);
		border-radius: 9px;
		font-size: 11px;
		font-weight: 600;
		color: var(--c-dark-green);
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	/* ── Sidebar ──────────────────────────────────────────────── */
	.msg-sidebar {
		background: var(--c-panel);
		overflow-y: auto;
		scrollbar-width: none;
	}
	.msg-sidebar::-webkit-scrollbar {
		display: none;
	}

	.msg-sidebar nav {
		padding: 12px 10px 24px;
	}

	.msg-nav-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 0;
		margin: 0;
	}

	.msg-nav-group {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--c-dark-green);
		padding: 14px 8px 6px;
	}

	.msg-nav-link {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 44px;
		padding: 0 12px;
		border-radius: 6px;
		text-decoration: none;
		color: var(--c-body);
		font-size: 16px;
		font-weight: 600;
		transition: background 120ms;
	}
	.msg-nav-link:hover {
		background: rgba(0, 71, 57, 0.05);
	}
	.msg-nav-link[aria-current="page"] {
		background: var(--c-white);
		color: var(--c-dark);
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.04),
			0 3px 8px var(--c-shadow);
	}

	.msg-nav-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.msg-nav-link[aria-current="page"] .msg-nav-icon {
		color: var(--c-teal);
	}

	/* ── Workspace ────────────────────────────────────────────── */
	.msg-workspace {
		grid-column: 2 / -1;
		grid-row: 2;
		display: grid;
		grid-template-columns: subgrid; /* inherits cols 2 & 3 */
		container-type: normal;
		overflow: hidden;
		background-color: transparent;

		&::before {
			content: none;
			background: transparent;
		}
	}

	/* ── Thread list panel ────────────────────────────────────── */
	.msg-threads-panel {
		grid-column: 1;
		display: flex;
		flex-direction: column;
		background: var(--c-panel);
		overflow: hidden;
	}

	.msg-threads-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 68px;
		padding: 0 16px;
		flex-shrink: 0;
		border-bottom: 1px solid var(--c-border);
	}

	.msg-btn-new {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 20px;
		background: var(--c-teal);
		color: white;
		font-size: 16px;
		font-weight: 700;
		border: none;
		border-radius: 6px;
		text-decoration: none;
		cursor: pointer;
		transition: filter 120ms;
	}
	.msg-btn-new:hover {
		filter: brightness(1.08);
	}

	.msg-toolbar-btn {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.65);
		border: none;
		border-radius: 6px;
		color: var(--c-dark);
		cursor: pointer;
	}

	.msg-thread-list {
		list-style: none;
		padding: 0;
		margin: 0;
		flex: 1;
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--c-border) transparent;
	}

	.msg-thread a {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		padding: 12px 18px;
		min-height: 68px;
		border-bottom: 1px solid var(--c-border);
		text-decoration: none;
		color: inherit;
		transition: background 80ms;
	}
	.msg-thread a:hover {
		background: rgba(255, 255, 255, 0.5);
	}
	.msg-thread a[aria-current="page"] {
		background: var(--c-white);
		box-shadow: 0 2px 8px var(--c-shadow);
		min-height: 77px;
	}

	.msg-thread-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
	}
	.msg-thread-name {
		font-size: 16px;
		font-weight: 700;
		color: var(--c-dark);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.msg-thread-subject {
		font-size: 16px;
		font-weight: 600;
		color: var(--c-dark);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.msg-thread-date {
		font-size: 14px;
		color: var(--c-body);
		flex-shrink: 0;
	}
	.msg-thread-bottom {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
	}
	.msg-thread-preview {
		font-size: 16px;
		color: var(--c-body);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex: 1;
	}
	.msg-unread-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--c-yellow);
		flex-shrink: 0;
		display: inline-block;
	}

	/* ── Conversation panel ───────────────────────────────────── */
	.msg-conv {
		grid-column: 2;
		display: flex;
		flex-direction: column;
		background: var(--c-panel);
		overflow: hidden;
	}

	.msg-conv-header {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 68px;
		padding: 0 14px 0 16px;
		flex-shrink: 0;
		border-bottom: 1px solid var(--c-border);
	}

	.msg-conv-back {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(233, 245, 244, 0.1);
		border: none;
		border-radius: 6px;
		color: var(--c-dark-green);
		cursor: pointer;
		flex-shrink: 0;
	}
	.msg-conv-avatar {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
	}
	.msg-conv-avatar svg {
		display: block;
	}
	.msg-conv-meta {
		flex: 1;
		min-width: 0;
	}
	.msg-conv-name {
		font-size: 20px;
		font-weight: 700;
		color: var(--c-dark);
		line-height: 1.2;
	}
	.msg-conv-subtitle {
		font-size: 14px;
		color: var(--c-body);
	}
	.msg-conv-actions {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.msg-conv-btn {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.75);
		border: none;
		border-radius: 6px;
		color: var(--c-body);
		cursor: pointer;
		transition: background 120ms;
	}
	.msg-conv-btn:hover {
		background: var(--c-white);
	}
	.msg-conv-divider {
		height: 1px;
		background: var(--c-border);
		flex-shrink: 0;
	}

	/* ── Message log ──────────────────────────────────────────── */
	.msg-log {
		list-style: none;
		margin: 0;
		flex: 1;
		overflow-y: auto;
		padding: 20px 22px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		scrollbar-width: thin;
		scrollbar-color: var(--c-border) transparent;
	}

	.msg-date-sep {
		text-align: center;
		font-size: 14px;
		color: var(--c-body);
		opacity: 0.7;
		padding: 6px 0;
	}

	.msg-message {
		display: flex;
	}
	.msg-message article {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 480px;
	}
	.msg-message footer {
		display: flex;
		align-items: flex-start;
		gap: 6px;
	}

	.msg-message--in {
		justify-content: flex-start;
	}
	.msg-message--out {
		justify-content: flex-end;
	}

	.msg-bubble-body {
		padding: 12px 16px;
		border-radius: 12px;
		font-size: 16px;
		color: var(--c-body);
		line-height: 1.5;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.msg-message--in .msg-bubble-body {
		background: var(--c-bubble-in);
	}
	.msg-message--out .msg-bubble-body {
		background: var(--c-bubble-out);
	}
	.msg-bubble-body--image {
		flex-direction: row;
		align-items: center;
		gap: 14px;
	}
	.msg-image-label {
		font-size: 14px;
		font-weight: 700;
		color: var(--c-dark);
	}
	.msg-image-sub {
		font-size: 14px;
		color: var(--c-dark-green);
	}

	.msg-attachment {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		background: rgba(255, 255, 255, 0.45);
		border-radius: 8px;
		text-decoration: none;
		color: var(--c-link);
	}
	.msg-attachment-name {
		display: block;
		font-size: 16px;
		font-weight: 700;
		color: var(--c-link);
	}
	.msg-attachment-date {
		display: block;
		font-size: 12px;
		color: var(--c-muted);
	}

	.msg-msg-menu {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.4);
		border: none;
		border-radius: 6px;
		color: var(--c-body);
		cursor: pointer;
		opacity: 0;
		transition: opacity 120ms;
		flex-shrink: 0;
	}
	.msg-message:hover .msg-msg-menu {
		opacity: 1;
	}

	.msg-read-receipt {
		font-size: 14px;
		color: var(--c-body);
		padding: 2px 4px;
		align-self: flex-start;
	}

	/* Sentiment dl */
	.msg-sentiment {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 14px;
		background: var(--c-bubble-out);
		border-radius: 8px;
		font-size: 14px;
		color: #3d6161;
	}
	.msg-sentiment div {
		display: flex;
		gap: 6px;
	}
	.msg-sentiment dt {
		font-weight: 600;
		flex-shrink: 0;
	}
	.msg-sentiment dd {
		line-height: 1.55;
	}

	/* ── Composer ─────────────────────────────────────────────── */
	.msg-composer {
		flex-shrink: 0;
		margin: 0 14px 14px;
		background: var(--c-white);
		border-radius: 8px;
		box-shadow:
			0 -1px 0 var(--c-border),
			0 2px 8px var(--c-shadow);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	.msg-composer textarea {
		flex: 1;
		border: none;
		outline: none;
		resize: none;
		font-family: inherit;
		font-size: 14px;
		color: var(--c-body);
		line-height: 1.5;
		padding: 14px 16px 8px;
		background: transparent;
		min-height: 52px;
	}
	.msg-composer textarea::placeholder {
		color: var(--c-body);
		opacity: 0.45;
	}

	.msg-composer-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 8px 8px 8px 4px;
		border-top: 1px solid var(--c-border);
	}
	.msg-composer-tools {
		display: flex;
		align-items: center;
	}
	.msg-tool-btn {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		border-radius: 6px;
		color: var(--c-body);
		cursor: pointer;
		transition: background 120ms;
	}
	.msg-tool-btn:hover {
		background: var(--c-panel);
	}

	.msg-send-btn {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--c-teal);
		border: none;
		border-radius: 6px;
		color: white;
		cursor: pointer;
		transition: filter 120ms;
	}
	.msg-send-btn:hover {
		filter: brightness(1.08);
	}

	/* ── Alpine cloak ────────────────────────────────────────── */
	[x-cloak] { display: none !important; }

	/* ── AI Coach workspace ──────────────────────────────────── */
	.msg-coach-workspace {
		grid-column: 2 / -1;
		grid-row: 2;
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		background: var(--c-panel);
	}

	/* ── Welcome view ────────────────────────────────────────── */
	.msg-coach-welcome {
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--c-border) transparent;
		background: linear-gradient(180deg, var(--c-panel) 0%, #e9f1ef 40%, #dfe8e5 100%);
	}
	.msg-coach-welcome-inner {
		max-width: 520px;
		margin: 0 auto;
		padding: 48px 24px 40px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}

	.msg-coach-hero {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}
	.msg-coach-icon {
		width: 72px;
		height: 72px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.msg-coach-title {
		font-size: 24px;
		font-weight: 700;
		color: var(--c-dark);
		line-height: 1.2;
	}
	.msg-coach-subtitle {
		font-size: 15px;
		color: var(--c-body);
		line-height: 1.5;
		max-width: 320px;
	}

	/* Features list */
	.msg-coach-features {
		display: flex;
		flex-direction: column;
		gap: 10px;
		width: 100%;
		padding: 20px 24px;
		background: var(--c-white);
		border-radius: 12px;
		box-shadow: 0 2px 8px var(--c-shadow);
	}
	.msg-coach-feature {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 14px;
		color: var(--c-body);
		line-height: 1.45;
	}
	.msg-coach-feature svg {
		flex-shrink: 0;
		margin-top: 1px;
	}

	/* New chat button */
	.msg-coach-new-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		max-width: 400px;
		height: 52px;
		padding: 0 24px;
		background: var(--c-dark-green);
		color: white;
		font-size: 16px;
		font-weight: 700;
		border: none;
		border-radius: 10px;
		cursor: pointer;
		transition: filter 120ms;
	}
	.msg-coach-new-btn:hover {
		filter: brightness(1.15);
	}

	.msg-coach-privacy {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: var(--c-muted);
	}

	/* Chat history */
	.msg-coach-history {
		width: 100%;
		margin-top: 8px;
	}
	.msg-coach-history-label {
		font-size: 13px;
		font-weight: 500;
		color: var(--c-muted);
		padding: 0 0 8px;
	}
	.msg-coach-chat-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.msg-coach-chat-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
		padding: 14px 16px;
		background: var(--c-white);
		border: 1px solid var(--c-border);
		border-radius: 10px;
		cursor: pointer;
		text-align: left;
		transition: box-shadow 120ms;
	}
	.msg-coach-chat-item:hover {
		box-shadow: 0 2px 8px var(--c-shadow);
	}
	.msg-coach-chat-topic {
		font-size: 15px;
		font-weight: 600;
		color: var(--c-dark);
		line-height: 1.35;
	}
	.msg-coach-chat-date {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		font-size: 13px;
		color: var(--c-muted);
		flex-shrink: 0;
		line-height: 1.4;
	}

	/* ── Chat view ───────────────────────────────────────────── */
	.msg-coach-chat {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		height: 100%;
	}

	.msg-coach-chat-header {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 68px;
		padding: 0 16px;
		flex-shrink: 0;
		border-bottom: 1px solid var(--c-border);
	}
	.msg-coach-chat-header-info {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 1;
	}
	.msg-coach-avatar-sm {
		width: 36px;
		height: 36px;
		flex-shrink: 0;
	}
	.msg-coach-chat-name {
		font-size: 17px;
		font-weight: 700;
		color: var(--c-dark);
		line-height: 1.2;
	}
	.msg-coach-online {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 13px;
		color: var(--c-teal);
	}
	.msg-coach-online-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--c-teal);
	}

	/* Messages */
	.msg-coach-messages {
		list-style: none;
		padding: 20px 22px;
		margin: 0;
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
		scrollbar-width: thin;
		scrollbar-color: var(--c-border) transparent;
	}

	.msg-coach-msg {
		display: flex;
		gap: 10px;
	}
	.msg-coach-msg--user {
		justify-content: flex-end;
	}
	.msg-coach-msg-avatar {
		flex-shrink: 0;
		margin-top: 4px;
	}
	.msg-coach-msg-content {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 520px;
	}
	.msg-coach-msg-label {
		font-size: 13px;
		font-weight: 600;
		color: var(--c-dark);
		padding-left: 2px;
	}

	.msg-coach-msg-bubble {
		padding: 14px 18px;
		border-radius: 14px;
		font-size: 15px;
		line-height: 1.55;
		color: var(--c-body);
	}
	.msg-coach-msg--bot .msg-coach-msg-bubble {
		background: var(--c-white);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
	}
	.msg-coach-msg--user .msg-coach-msg-bubble {
		background: var(--c-bubble-out);
		max-width: 420px;
	}

	.msg-coach-msg-bubble p + p {
		margin-top: 10px;
	}
	.msg-coach-tips {
		margin: 8px 0 4px;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.msg-coach-tips li {
		line-height: 1.5;
	}
	.msg-coach-draft {
		margin: 8px 0;
		padding: 12px 16px;
		background: #e8f5f2;
		border-left: 3px solid var(--c-teal);
		border-radius: 6px;
		font-style: italic;
		line-height: 1.55;
	}

	/* Topic suggestions */
	.msg-coach-suggestions {
		flex-shrink: 0;
		padding: 12px 22px;
		border-top: 1px solid var(--c-border);
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.msg-coach-suggestions-label {
		font-size: 13px;
		color: var(--c-muted);
	}
	.msg-coach-suggestion-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.msg-coach-chip {
		padding: 8px 14px;
		background: var(--c-white);
		border: 1px solid var(--c-border);
		border-radius: 20px;
		font-size: 13px;
		font-weight: 500;
		color: var(--c-dark);
		cursor: pointer;
		transition: background 120ms, box-shadow 120ms;
	}
	.msg-coach-chip:hover {
		background: #e8f5f2;
		box-shadow: 0 1px 4px var(--c-shadow);
	}

	/* Composer */
	.msg-coach-composer {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 14px 14px;
		padding: 6px 6px 6px 16px;
		background: var(--c-white);
		border-radius: 28px;
		box-shadow: 0 2px 8px var(--c-shadow);
	}
	.msg-coach-input {
		flex: 1;
		border: none;
		outline: none;
		font-family: inherit;
		font-size: 15px;
		color: var(--c-body);
		background: transparent;
		height: 44px;
	}
	.msg-coach-input::placeholder {
		color: var(--c-body);
		opacity: 0.45;
	}
	.msg-coach-send {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--c-dark-green);
		border: none;
		border-radius: 50%;
		color: white;
		cursor: pointer;
		flex-shrink: 0;
		transition: filter 120ms;
	}
	.msg-coach-send:hover {
		filter: brightness(1.15);
	}

	/* ── Tablet: 2-column (hide sidebar) ─────────────────────── */
	@media (max-width: 1024px) {
		.grid {
			grid-template-columns:
				minmax(var(--list-min), var(--list-max))
				1fr;
			gap: 0;
		}
		.msg-header {
			grid-template-columns:
				auto
				1fr
				auto;
		}
		.msg-sidebar {
			display: none;
		}
		.msg-workspace {
			grid-column: 1 / -1;
		}
		.msg-coach-workspace {
			grid-column: 1 / -1;
		}
	}

	/* ── Mobile: single panel ────────────────────────────────── */
	@media (max-width: 640px) {
		:root {
			--sidebar-min: 100%;
			--sidebar-max: 100%;
			--list-min: 100%;
			--list-max: 100%;
		}

		.grid {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			gap: 0;
		}

		/* Header */
		.msg-header {
			grid-column: 1;
			grid-template-columns: 1fr auto;
			height: 56px;
			padding-top: 12px;
