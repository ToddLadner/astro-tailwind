---
import Layout from "@layouts/Layout.astro";

import Avatar from "@components/Avatar.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";

import userAvatar from "@images/killer-mike.jpg";

const {
	title = "My Astro Blog",
	description = "My musings about the Astro framework",
	...rest
} = Astro.props;
---

<Layout {title} {description}>
	<main class="bg-surface-2">
		<article class="px-max py-xl stack-md">
			<p>Components</p>
			<h1>Card</h1>

			<p>
				A minimally styled window overlaid on the main content. By design the
				Dialog is minimal with zero content to allow for both modal and
				non-modal use.
			</p>

			<div class="grid-ram [--col-min:16rem] gap-xs">
				<Card theme="tonal" classes="shadow-sm" style="--weight: 450">
					<h3 class="--weight">Card test title</h3>
					<p>Discover fascinating unusual and adventurious things to do.</p>
					<div class="flex items-center gap-xs mt-md">
						<Avatar
							src={userAvatar}
							label="User Avatar"
							size="sm"
							badge="success"
						/>
						<p class="leading-sm">
							Michael Santiago Render
							<br>
							15 Feb 2026
						</p>
					</div>
				</Card>
				<Card theme="tonal" classes="shadow-sm" style="--weight: 450">
					<h3 class="--weight">Card test title</h3>
					<p>Discover fascinating unusual and adventurious things to do.</p>
					<div class="flex items-center gap-xs mt-md">
						<Avatar
							src={userAvatar}
							label="User Avatar"
							size="sm"
							badge="success"
						/>
						<p class="leading-sm">
							Michael Santiago Render
							<br>
							15 Feb 2026
						</p>
					</div>
				</Card>
			</div>
		</article>
	</main>
</Layout>
