---
import Layout from "@layouts/Layout.astro";
import { pokemon } from "../../data/pokemon";

const { title, description } = Astro.props;
---

<Layout {title} {description}>
	<main>
		<ul>
			{pokemon.map((p) => (
          <li>
            <a href={`/pokeymon/${p.name}`}>{p.name}</a>
          </li>
        ))}
		</ul>
	</main>
</Layout>
