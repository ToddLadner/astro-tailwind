---
import type { DocGroup } from "../../docs/types";

interface Props {
	group: DocGroup<unknown>;
}

const { group } = Astro.props;
---

<section id={group.id} class="example-group stack-md" aria-labelledby={`${group.id}-heading`}>
	<header class="stack-xs">
		<h2 id={`${group.id}-heading`}>{group.title}</h2>
		{group.description && <p>{group.description}</p>}
	</header>
	<div class="example-grid">
		<slot />
	</div>
</section>

<style>
.example-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
	gap: var(--spacing-lg);
	align-items: start;
}
</style>
