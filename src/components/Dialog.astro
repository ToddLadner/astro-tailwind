---
import Button from "@components/Button.astro";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"dialog"> {
	id: string;
	role?: "alertdialog" | "dialog";
	showHeader?: boolean;
	showFooter?: boolean;
	heading: string;
	overline?: string;
	icon?: string;
}

const {
	id,
	role = "dialog",
	showHeader = true,
	showFooter = true,
	heading,
	overline,
	icon,
	class: className,
	"aria-label": ariaLabel,
	"aria-describedby": ariaDescribedby,
	...rest
} = Astro.props;

const headingId = `${id}-heading`;
const contentId = `${id}-content`;
---

<style>
@layer components {
	dialog {
		--bg-color: var(--color-surface-1);
		--border-color: transparent;
		--border-width: 0;
		--shadow: var(--shadow-lg);

		display: grid;
		grid-template-rows: auto 1fr auto;
		max-height: 75dvh;
		border-radius: var(--radius-md);
		pointer-events: none;
		padding: 0;
		inset: 0;
		box-shadow: var(--shadow);
		width: min(100%, var(--measure-lg));
		overflow: hidden;
		max-width: none;

		&:not([open]) {
			display: none;
		}

		&[open] {
			pointer-events: all;
		}

		:is(header, .content, footer) {
			padding-inline: var(--spacing-sm);
		}
		:is(header, footer) {
			padding-block: var(--spacing-sm);
			background-color: var(--color-surface-2);
		}
		.content {
			overflow-y: auto;
			padding-block: var(--spacing-md);
		}
	}

	html:has(dialog[open]:not([role="alertdialog"])) {
		overflow: hidden;
	}

	/* Transition */
	dialog,
	dialog::backdrop {
		--duration: 1s;
		--delay: 0.25s;
		--timing-function: var(--ease-spring-2);

		/* Interpolate sizes keywords */
		transition:
			display var(--duration) var(--timing-function),
			overlay var(--duration) var(--timing-function),
			transform var(--duration) var(--timing-function),
			opacity var(--duration) var(--timing-function);
		transition-behavior: allow-discrete; /* Note: be sure to write this after the shorthand */
	}

	/* Ending | Off Stage  */
	dialog {
		transform: scale(0.9);
	}

	dialog,
	dialog::backdrop {
		opacity: 0;
	}

	/* On Stage */
	dialog[open]::backdrop {
		opacity: 1;
	}

	dialog[open] {
		opacity: 1;
		transform: translateY(0);
	}

	/* Starting | Off Stage */
	@starting-style {
		dialog[open] {
			opacity: 0;
			transform: translateY(20%);
		}

		dialog[open]::backdrop {
			opacity: 0;
		}
	}

	/* Backdrop */
	dialog::backdrop {
		--glass-lightness: 100%;

		background: hsl(0 0% var(--glass-lightness) / 50%);
		backdrop-filter: blur(6px);

		@media (prefers-color-scheme: dark) {
			--glass-lightness: 0;
		}
	}
}

dialog[role="alertdialog"] {
	margin-bottom: 10vh;
	position: fixed;
}
</style>
<style is:global>
[color-scheme="light"] ::backdrop {
	background: hsl(0 0% var(--glass-lightness) / 50%);
}
[color-scheme="dark"] ::backdrop {
	--glass-lightness: 0;
}
</style>

<dialog
	id={id}
	role={role}
	class="modal"
	class:list={[className]}
	aria-modal="true"
	aria-describedby={ariaDescribedby ?? contentId}
	{...(showHeader
    ? { 'aria-labelledby': headingId }
    : { 'aria-label': ariaLabel ?? heading })}
	{...rest}
>
	<!-- Header | If showHeader is true -->
	{showHeader && (
    <header class="flex items-center gap-xs">
      <!-- Icon -->
      {icon && <Icon name={icon} class="icon" />}
      <!-- Heading -->
      <hgroup class="flex flex-col stack-3xs">
        {overline && <p class="text-xs">{overline}</p>}  
        <h2 id={headingId} class="text-lg">{heading}</h2>
      </hgroup>
      <!-- Close Button -->
      <Button
        onclick="this.closest('dialog').close()"
        theme='filled' 
        variant='icon-button'
        icon='xmark-large-solid' 
        aria-label='close dialog'
        aria-controls={contentId}
        classes="ml-[auto]"
      />
    </header>
  )}
	<!-- Content -->
	<article id={contentId} class="content stack-md">
		<slot />
	</article>
	<!-- Footer -->
	{showFooter && (
    <footer class="actions flex justify-end gap-xs">
      <slot name="dialog-footer" />
    </footer>
  )}
</dialog>

<script>
if (typeof window !== "undefined") {
	const addBaseDialogHandlers = (dialog: HTMLDialogElement) => {
		if (dialog.dataset.dialogHydrated === "true") return;
		dialog.dataset.dialogHydrated = "true";

		const handleCancel = (event: Event) => {
			event.preventDefault();
			dialog.close();
		};

		const handleBackdropClick = (event: MouseEvent) => {
			if (event.target === dialog) {
				dialog.close();
			}
		};

		dialog.addEventListener("cancel", handleCancel);
		dialog.addEventListener("click", handleBackdropClick);
	};

	// Initialize focus trap when DOM is ready
	const initializeFocusTrap = async () => {
		try {
			const { createFocusTrap } = await import("focus-trap");

			document.querySelectorAll<HTMLDialogElement>(".modal").forEach((dialog) => {
				addBaseDialogHandlers(dialog);
				if (dialog.dataset.focusTrapReady === "true") return;
				dialog.dataset.focusTrapReady = "true";

				const trap = createFocusTrap(dialog, {
					clickOutsideDeactivates: true,
					escapeDeactivates: true,
					returnFocusOnDeactivate: true,
					fallbackFocus: dialog,
				});

				const activateTrap = () => trap.activate();
				const deactivateTrap = () => trap.deactivate();

				// Override showModal to activate trap
				const origShowModal = dialog.showModal.bind(dialog);
				dialog.showModal = (() => {
					origShowModal();
					activateTrap();
				}) as HTMLDialogElement["showModal"];

				// Override show to activate trap
				const origShow = dialog.show.bind(dialog);
				dialog.show = (() => {
					origShow();
					activateTrap();
				}) as HTMLDialogElement["show"];

				// Deactivate on close
				dialog.addEventListener("close", () => {
					deactivateTrap();
				});
			});
		} catch (err) {
			console.error("Failed to initialize focus-trap:", err);
			document.querySelectorAll<HTMLDialogElement>(".modal").forEach(addBaseDialogHandlers);
		}
	};

	// Run when DOM is ready
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initializeFocusTrap);
	} else {
		initializeFocusTrap();
	}
}
</script>
