---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Element = "input" | "textarea" | "select";

type SharedProps = {
	as?: Element;
	id?: string;
	uid?: string;
	label?: string;
	icon?: string;
	error?: string;
	classes?: string;
	required?: boolean;
};

type InputProps = HTMLAttributes<"input"> &
	SharedProps & { as?: "input"; options?: never };
type TextareaProps = HTMLAttributes<"textarea"> &
	SharedProps & { as: "textarea"; options?: never };
type SelectProps = HTMLAttributes<"select"> &
	SharedProps & { as: "select"; options?: { value: string; label: string }[] };

type Props = InputProps | TextareaProps | SelectProps;

const props = Astro.props as Props & {
	"aria-describedby"?: string;
	"aria-invalid"?: string | boolean;
};

const {
	as = "input",
	id: propId,
	uid,
	label,
	icon,
	error,
	classes = "",
	required,
	options = [],
	"aria-describedby": ariaDescribedByProp,
	"aria-invalid": ariaInvalidProp,
	...rest
} = props;

// Generate ID with secure random fallback
const id =
	propId ??
	uid ??
	`field-${crypto.getRandomValues(new Uint8Array(4)).reduce((s, b) => s + b.toString(16).padStart(2, "0"), "")}`;

// Determine aria attributes
const describedBy = ariaDescribedByProp ?? (error ? `${id}-error` : undefined);
const ariaInvalid = ariaInvalidProp ?? (error ? "true" : undefined);

// Normalize required behavior:
// - required present (or required={true}) => required
// - required omitted or required={false} => optional
const isRequired = required === true;
const isOptional = !isRequired;
---

<style>
/* [1] Field */
.field {
	background-color: var(--color-surface-1);
	max-width: var(--measure-sm);
	padding: var(--spacing-2xs) var(--spacing-2xs);
	border-radius: var(--radius-md);
	border: 2px solid var(--color-surface-3);
	transition:
		border-color 0.2s,
		box-shadow 0.2s;

	&:focus-within {
		border: 2px solid var(--color-brand);
		box-shadow: 0px 0px 10px 4px oklch(from var(--color-brand) l c h / 23%);
	}

	/* [2] Label */
	.label {
		font-size: var(--text-sm);
	}

	.optional {
		color: var(--color-surface-4);
		font-weight: normal;
	}

	/* [3] Input, Textarea, Select */
	.control {
		background-color: transparent;
		width: 100%;
		font-size: var(--text-md);

		&:focus {
			outline: none;
		}
	}

	/* Error state */
	&[aria-invalid="true"] {
		border-color: var(--color-red-5);
		--error-color: var(--color-red-5);
	}
}

:is(input, textarea, select)::placeholder {
	color: var(--color-surface-4);
}

/* [4] Validation */
.field:has(:is(input, textarea, select):user-valid) {
	border-color: var(--color-green-5);
}
.field:has(:is(input, textarea, select):user-invalid),
.field[aria-invalid="true"] {
	border-color: var(--color-red-5);
}

/* [5] Error message */
.error-message {
	color: var(--error-color, var(--color-red-5));
	font-size: var(--font-size-xs);
	margin-top: var(--spacing-2xs);
}
</style>

<label for={id} class="field grid gap-2xs" class:list={[classes]}>
	{label && (
    <span class="label flex items-center gap-xs">
      {icon && <Icon name={icon} />}
      {label}
			{isOptional && <span class="optional">(optional)</span>}
    </span>
  )}

	{as === 'input' && (
    <input
      id={id}
      class="control"
      aria-describedby={describedBy}
      aria-invalid={ariaInvalid}
      {...(isRequired ? { required: true } : {})}
      {...rest}
    />
		<p class="text-xs text-secondary mt-3xs">Must be longer than 12 characters and contain at least one special symbol like @#$% etc.</p>
  )}

	{as === 'textarea' && (
    <textarea
      id={id}
      class="control resize-y"
      aria-describedby={describedBy}
      aria-invalid={ariaInvalid}
      {...(isRequired ? { required: true } : {})}
      {...rest}
    />
		<p class="text-xs text-secondary mt-3xs">Must be longer than 12 characters and contain at least one special symbol like @#$% etc.</p>
  )}

	{as === 'select' && (
    <select
      id={id}
      class="control"
      aria-describedby={describedBy}
      aria-invalid={ariaInvalid}
      {...(isRequired ? { required: true } : {})}
      {...rest}
    >
      {options.map(o => <option value={o.value}>{o.label}</option>)}
    </select>
		<p class="text-xs text-secondary mt-3xs">Must be longer than 12 characters and contain at least one special symbol like @#$% etc.</p>
  )}

	{error && (
    <span id={`${id}-error`} class="error-message" role="alert">
      {error}
    </span>
  )}
</label>
