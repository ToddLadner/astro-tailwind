---
// Dropdown.astro
import type { HTMLAttributes } from "astro/types";
import Button, { type PureButtonProps } from "@components/Button.astro";

type Behavior = "menu" | "popover-menu";

interface Props extends HTMLAttributes<"div"> {
  /** Base id for this dropdown (used to generate button + menu ids) */
  id: string;

  /** Optional label; falls back to triggerProps.text or "Actions" */
  label?: string;

  /** Props to pass to your Button.astro */
  triggerProps?: PureButtonProps;

  /**
   * "menu"         = classic hidden/absolute dropdown (no top layer)
   * "popover-menu" = Popover API (top layer + light dismiss) + Anchor positioning
   */
  behavior?: Behavior;
}

const { id, label, triggerProps, behavior = "menu", ...rest } = Astro.props as Props;

const rootId = `dropdown-${id}`;
const buttonId = `${id}-button`;
const menuId = `${id}-menu`;

const triggerClasses = ["dropdown-button", triggerProps?.classes].filter(Boolean).join(" ");

const buttonProps: PureButtonProps = {
  type: "button",
  "aria-haspopup": "menu",
  "aria-expanded": "false",
  "aria-controls": menuId,
  ...triggerProps,
  classes: triggerClasses,
  text: label ?? triggerProps?.text ?? "Actions",
};

const isPopover = behavior === "popover-menu";
---

<div id={rootId} class="dropdown" data-dropdown data-behavior={behavior} {...rest}>
  <Button
    {...buttonProps}
    id={buttonId}
    data-dropdown-button
    data-dropdown-anchor
  />

  <ul
    class="dropdown-menu list-none"
    id={menuId}
    role="menu"
    aria-labelledby={buttonId}
    data-dropdown-menu
    {...(isPopover ? { popover: "auto" } : { hidden: true })}
  >
    <slot />
  </ul>
</div>

<style>
  .dropdown {
    display: inline-block;
    position: relative;
  }

  [data-dropdown-anchor] {
  anchor-name: --dropdown-anchor;
}

  /* Shared menu surface styles */
  .dropdown-menu {
    --d: 0.75rem;
    --s: 1.1rem;

    padding-left: 0;
    margin: 0;

    anchor-name: --dropdown-menu;
    
    background: var(--color-surface-2, white);
    border-radius: var(--radius-md, 0.375rem);
    box-shadow: var(--shadow-md, 0 10px 15px -3px rgba(0,0,0,.1));
    min-inline-size: 9rem;
  }

  /* Classic dropdown positioning (in normal layer) */
  .dropdown-menu[hidden] {
    display: none;
  }
  .dropdown-menu:not([popover]) {
    position: absolute;
  top: 100%;
  left: 0;
  margin-top: var(--d);
  z-index: 50;
    
  }

  /* Popover positioning (top layer) + Anchor positioning */
  .dropdown-menu[popover] {
    position: absolute; /* ok in top-layer; can also be fixed */
    position-anchor: --dropdown-anchor;
    position-area: bottom;
    margin-top: var(--d);
    position-try: flip-block;
  }

  /* Optional "arrow" (kept from your approach) */
  .dropdown-menu::before {
    content: "";
    position: fixed;
    z-index: -1;
    width: var(--s);
    background: inherit;
    background: red;

    top:    calc(anchor(--dropdown-menu top)    - var(--d));
    bottom: calc(anchor(--dropdown-menu bottom) - var(--d));
    left:   calc(anchor(--dropdown-anchor center) - var(--s) / 2);

    clip-path: polygon(
      50% .2em,
      100% var(--d),
      100% calc(100% - var(--d)),
      50% calc(100% - .2em),
      0 calc(100% - var(--d)),
      0 var(--d)
    );
  }

  [role="menuitem"] {
    inline-size: 100%;
    justify-content: flex-start;
  }
</style>

<script is:inline define:vars={{ rootId, behavior }}>
  (function () {
    const root = document.getElementById(rootId);
    if (!root) return;

    const button = root.querySelector("[data-dropdown-button]");
    const menu = root.querySelector("[data-dropdown-menu]");
    if (!button || !menu) return;

    const supportsPopover = typeof menu.showPopover === "function" && typeof menu.hidePopover === "function";
    const usePopover = behavior === "popover-menu" && supportsPopover;

    /** @returns {HTMLElement[]} */
    const getItems = () => Array.from(menu.querySelectorAll('[role="menuitem"]'));

    const isOpen = () => (usePopover ? menu.matches(":popover-open") : !menu.hidden);

    const setExpanded = (value) => button.setAttribute("aria-expanded", value ? "true" : "false");

    const openMenu = (focus = "first") => {
      if (isOpen()) return;

      if (usePopover) {
        menu.showPopover();
      } else {
        menu.hidden = false;
      }

      setExpanded(true);

      const items = getItems();
      if (!items.length) return;
      (focus === "last" ? items[items.length - 1] : items[0]).focus();
    };

    const closeMenu = ({ returnFocus = true } = {}) => {
      if (!isOpen()) return;

      if (usePopover) {
        menu.hidePopover();
      } else {
        menu.hidden = true;
      }

      setExpanded(false);
      if (returnFocus) button.focus();
    };

    const toggleMenu = () => (isOpen() ? closeMenu({ returnFocus: true }) : openMenu("first"));

    const moveFocus = (direction) => {
      const items = getItems();
      if (!items.length) return;

      const active = document.activeElement;
      let index = items.indexOf(active);

      if (index === -1) index = direction > 0 ? -1 : 0;

      let nextIndex = index + direction;
      if (nextIndex < 0) nextIndex = items.length - 1;
      if (nextIndex >= items.length) nextIndex = 0;

      items[nextIndex].focus();
    };

    // Keep aria-expanded synced for popover open/close (light dismiss / ESC)
    if (usePopover) {
      menu.addEventListener("toggle", () => setExpanded(isOpen()));
    }

    // Click on button toggles menu
    button.addEventListener("click", (event) => {
      event.preventDefault();
      toggleMenu();
    });

    // Keyboard on button
    button.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
        case "Enter":
        case " ":
          event.preventDefault();
          openMenu("first");
          break;
        case "ArrowUp":
          event.preventDefault();
          openMenu("last");
          break;
      }
    });

    // Keyboard inside menu
    menu.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          moveFocus(1);
          break;
        case "ArrowUp":
          event.preventDefault();
          moveFocus(-1);
          break;
        case "Home":
          event.preventDefault();
          getItems()[0]?.focus();
          break;
        case "End": {
          event.preventDefault();
          const items = getItems();
          items[items.length - 1]?.focus();
          break;
        }
        case "Escape":
          // Popover will close on ESC by default; keep this so focus returns reliably.
          event.preventDefault();
          closeMenu({ returnFocus: true });
          break;
      }
    });

    // Click on any menuitem closes dropdown (common menu behavior)
    menu.addEventListener("click", (event) => {
      const menuItem = event.target.closest("[role='menuitem']");
      if (!menuItem) return;

      // Don’t force focus back if navigation will occur immediately
      closeMenu({ returnFocus: false });
    });

    // Outside click closes only for classic mode (popover mode already light-dismisses)
    if (!usePopover) {
      document.addEventListener("pointerdown", (event) => {
        if (menu.hidden) return;
        if (!root.contains(event.target)) closeMenu({ returnFocus: false });
      });
    }
  })();
</script>