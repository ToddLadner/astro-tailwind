---
import type { HTMLAttributes } from "astro/types";
import Button, { type PureButtonProps } from "@components/Button.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Base id for this dropdown (used to generate button + menu ids) */
  id: string;
  /** Optional label; falls back to triggerProps.text or "Actions" */
  label?: string;
  /** Props to pass to your Button.astro */
  triggerProps?: PureButtonProps;
}

const { id, label, triggerProps, ...rest } = Astro.props as Props;

const rootId = `dropdown-${id}`;
const buttonId = `${id}-button`;
const menuId = `${id}-menu`;

// Normalize classes for the trigger button
const triggerClasses = [
  "dropdown-button",
  triggerProps?.classes,
].filter(Boolean).join(" ");

const buttonProps: PureButtonProps = {
  type: "button",
  "aria-haspopup": "menu",
  "aria-expanded": "false",
  "aria-controls": menuId,
  // preserve / override any triggerProps passed in
  ...triggerProps,
  // ensure our dropdown class is always applied
  classes: triggerClasses,
  text: label ?? triggerProps?.text ?? "Actions",
};
---

<div
  id={rootId}
  class="dropdown"
  data-dropdown
  {...rest}
>
  <Button
    id={buttonId}
    data-dropdown-button
    {...buttonProps}
  />

  <ul
    class="dropdown-menu list-none"
    id={menuId}
    role="menu"
    aria-labelledby={buttonId}
    data-dropdown-menu
    hidden
  >
    <slot />
  </ul>
</div>

<style>
  .dropdown {
    position: relative;
    display: inline-block;
    /* This is the element we anchor to (like #anchor) */
    anchor-name: --anchor;
  }

  .dropdown-menu {
    --d: 1em;
    --s: 1.2em;

    position: absolute;
    z-index: 0;

    /* Anchor this menu to the trigger container */
    position-anchor: --anchor;

    /* Starts at bottom, flips to top if no room */
    inset-inline: auto;
    bottom: var(--d);
    position-area: bottom;
    margin-top: var(--d);       /* margin below anchor, like the original */
    position-try: flip-block;   /* flips position and margin when needed */
    anchor-name: --tooltip;     /* the pseudo-element will reference this */

    padding-left: 0;

    background: var(--color-surface-2, white);
    border-radius: var(--radius-md, 0.375rem);
    box-shadow: var(--shadow-md, 0 10px 15px -3px rgba(0,0,0,.1));
  }

  .dropdown-menu::before {
    content: "";
    position: fixed;            /* same as the original demo */
    z-index: -1;
    width: var(--s);
    background: inherit;

    /* vertical position from tooltip (restored from your reference) */
    top:    calc(anchor(--tooltip top)    - var(--d));
    bottom: calc(anchor(--tooltip bottom) - var(--d));

    /* horizontal position from the anchor (the trigger container) */
    left: calc(anchor(--anchor center) - var(--s) / 2);
    margin: inherit;

    clip-path: polygon(
      50% .2em,
      100% var(--d),
      100% calc(100% - var(--d)),
      50% calc(100% - .2em),
      0 calc(100% - var(--d)),
      0 var(--d)
    );
  }

  [role="menuitem"] {
    inline-size: 100%;
    justify-content: flex-start;
  }
</style>

<script is:inline define:vars={{ rootId }}>
  (function () {
    const root = document.getElementById(rootId);
    if (!root) return;

    const button = root.querySelector("[data-dropdown-button]");
    const menu = root.querySelector("[data-dropdown-menu]");

    if (!button || !menu) return;

    /** @returns {HTMLElement[]} */
    const getItems = () =>
      Array.from(menu.querySelectorAll('[role="menuitem"]'));

    const openMenu = () => {
      if (!menu.hidden) return;
      menu.hidden = false;
      button.setAttribute("aria-expanded", "true");

      const items = getItems();
      if (items[0]) {
        items[0].focus();
      }
    };

    const closeMenu = () => {
      if (menu.hidden) return;
      menu.hidden = true;
      button.setAttribute("aria-expanded", "false");
    };

    const toggleMenu = () => {
      if (menu.hidden) {
        openMenu();
      } else {
        closeMenu();
        button.focus();
      }
    };

    const moveFocus = (direction) => {
      const items = getItems();
      if (!items.length) return;

      const active = document.activeElement;
      let index = items.indexOf(active);

      if (index === -1) {
        index = direction > 0 ? -1 : 0;
      }

      let nextIndex = index + direction;
      if (nextIndex < 0) nextIndex = items.length - 1;
      if (nextIndex >= items.length) nextIndex = 0;

      items[nextIndex].focus();
    };

    // Click on button toggles menu
    button.addEventListener("click", (event) => {
      event.preventDefault();
      toggleMenu();
    });

    // Keyboard on button
    button.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
        case "Enter":
        case " ":
          event.preventDefault();
          if (menu.hidden) {
            openMenu();
          } else {
            const items = getItems();
            if (items[0]) items[0].focus();
          }
          break;
        case "ArrowUp": {
          event.preventDefault();
          if (menu.hidden) {
            openMenu();
          }
          const items = getItems();
          if (items.length) {
            items[items.length - 1].focus();
          }
          break;
        }
      }
    });

    // Keyboard inside menu
    menu.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          moveFocus(1);
          break;
        case "ArrowUp":
          event.preventDefault();
          moveFocus(-1);
          break;
        case "Home":
          event.preventDefault();
          {
            const items = getItems();
            if (items[0]) items[0].focus();
          }
          break;
        case "End":
          event.preventDefault();
          {
            const items = getItems();
            if (items.length) items[items.length - 1].focus();
          }
          break;
        case "Escape":
          event.preventDefault();
          closeMenu();
          button.focus();
          break;
      }
    });

    // Click on any menuitem closes dropdown
    menu.addEventListener("click", (event) => {
      const menuItem = event.target.closest("[role='menuitem']");
      if (!menuItem) return;
      closeMenu();
    });

    // Click outside closes dropdown
    document.addEventListener("pointerdown", (event) => {
      if (menu.hidden) return;
      if (!root.contains(event.target)) {
        closeMenu();
      }
    });
  })();
</script>