---
// Dropdown.astro
import type { HTMLAttributes } from "astro/types";
import Button, { type PureButtonProps } from "@components/Button.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Used as the button id + referenced by aria-labelledby */
  id: string;

  /** Optional label; falls back to triggerProps.text or "Actions" */
  label?: string;

  /** Props to pass to your Button.astro */
  triggerProps?: PureButtonProps;
}

const { id, label, triggerProps, ...rest } = Astro.props as Props;

const triggerText = label ?? triggerProps?.text ?? "Actions";

const buttonProps: PureButtonProps = {
  type: "button",
  "aria-haspopup": "menu",
  "aria-expanded": "false",
  "aria-controls": `${id}-menu`, // kept stable for a11y; menu id below matches
  ...triggerProps,
  // do NOT compute/force classes; you said you already handle classes via triggerProps.classes
  text: triggerText,
};

const menuId = `${id}-menu`;
---

<div id="dropdown" data-dropdown {...rest}>
  <Button
    {...buttonProps}
    id={id}
    data-dropdown-button
    data-dropdown-anchor
  />

  <ul
    class="dropdown-menu list-none"
    id={menuId}
    role="menu"
    aria-labelledby={id}
    data-dropdown-menu
    popover="auto"
  >
    <slot />
  </ul>
</div>

<style>
  #dropdown {
    display: inline-block;
    position: fixed;
    width: fit-content;

  }

  [data-dropdown-anchor] {
    anchor-name: --dropdown-anchor;
  }

  .dropdown-menu {
    --d: 1rem;
    --s: 1.2rem;

    /* Popover positioning (top layer) + Anchor positioning */
    position: absolute;
    z-index: 0;
    position-anchor: --dropdown-anchor;
    top: calc(var(--d) + 0.5rem);
    position-area: bottom;
    margin-bottom: var(--d);
    position-try: flip-block;
    anchor-name: --dropdown-menu;


    min-inline-size: 9rem;
    padding-block: var(--spacing-3xs);
    padding-inline: 0;  
    background: var(--color-surface-3, white);
    border-radius: var(--radius-md, 0.375rem);
    box-shadow: var(--shadow-md, 0 10px 15px -3px rgba(0,0,0,.1));
  }

  /* Optional "arrow" */
  .dropdown-menu::before {
    content: "";
    position: fixed;
    z-index: -1;
    width: var(--s);
    background: inherit;
    margin: inherit;

    top:    calc(anchor(--dropdown-menu top)    - var(--d));
    bottom: calc(anchor(--dropdown-menu bottom) - var(--d));
    left:   calc(anchor(--dropdown-anchor center) - var(--s) / 2);

    clip-path: polygon(
      50% .2em,
      100% var(--d),
      100% calc(100% - var(--d)),
      50% calc(100% - .2em),
      0 calc(100% - var(--d)),
      0 var(--d)
    );
  }
</style>

<script is:inline define:vars={{ id, menuId }}>
  (function () {
    const button = document.getElementById(id);
    const menu = document.getElementById(menuId);
    if (!button || !menu) return;

    const supportsPopover =
      typeof menu.showPopover === "function" &&
      typeof menu.hidePopover === "function";

    if (!supportsPopover) return;

    /** @returns {HTMLElement[]} */
    const getItems = () => Array.from(menu.querySelectorAll('[role="menuitem"]'));

    const isOpen = () => menu.matches(":popover-open");

    const setExpanded = (value) =>
      button.setAttribute("aria-expanded", value ? "true" : "false");

    const openMenu = (focus = "first") => {
      if (isOpen()) return;

      menu.showPopover();
      setExpanded(true);

      const items = getItems();
      if (!items.length) return;
      (focus === "last" ? items[items.length - 1] : items[0]).focus();
    };

    const closeMenu = ({ returnFocus = true } = {}) => {
      if (!isOpen()) return;

      menu.hidePopover();
      setExpanded(false);
      if (returnFocus) button.focus();
    };

    const toggleMenu = () =>
      isOpen() ? closeMenu({ returnFocus: true }) : openMenu("first");

    const moveFocus = (direction) => {
      const items = getItems();
      if (!items.length) return;

      const active = document.activeElement;
      let index = items.indexOf(active);

      if (index === -1) index = direction > 0 ? -1 : 0;

      let nextIndex = index + direction;
      if (nextIndex < 0) nextIndex = items.length - 1;
      if (nextIndex >= items.length) nextIndex = 0;

      items[nextIndex].focus();
    };

    // Keep aria-expanded synced for light dismiss / ESC / etc.
    menu.addEventListener("toggle", () => setExpanded(isOpen()));

    // Click on button toggles menu
    button.addEventListener("click", (event) => {
      event.preventDefault();
      toggleMenu();
    });

    // Keyboard on button
    button.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
        case "Enter":
        case " ":
          event.preventDefault();
          openMenu("first");
          break;
        case "ArrowUp":
          event.preventDefault();
          openMenu("last");
          break;
      }
    });

    // Keyboard inside menu
    menu.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          moveFocus(1);
          break;
        case "ArrowUp":
          event.preventDefault();
          moveFocus(-1);
          break;
        case "Home":
          event.preventDefault();
          getItems()[0]?.focus();
          break;
        case "End": {
          event.preventDefault();
          const items = getItems();
          items[items.length - 1]?.focus();
          break;
        }
        case "Escape":
          event.preventDefault();
          closeMenu({ returnFocus: true });
          break;
      }
    });

    // Click on any menuitem closes dropdown
    menu.addEventListener("click", (event) => {
      const menuItem = event.target.closest("[role='menuitem']");
      if (!menuItem) return;
      closeMenu({ returnFocus: false });
    });
  })();
</script>