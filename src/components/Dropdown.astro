---
// DropdownPopover.astro
import type { HTMLAttributes } from "astro/types";
import Button, { type PureButtonProps } from "@components/Button.astro";

type Props = HTMLAttributes<"div"> & {
  /** Base id for this dropdown */
  id: string;

  /** SR label for trigger (falls back to triggerProps.aria-label or "Open menu") */
  label?: string;

  /** Props forwarded to your Button.astro */
  triggerProps?: PureButtonProps;

  /** Close menu when a menuitem is clicked */
  closeOnSelect?: boolean;
};

const {
  id,
  label,
  triggerProps,
  closeOnSelect = true,
  ...rest
} = Astro.props as Props;

const triggerId = `${id}-trigger`;
const menuId = `${id}-menu`;

const ariaLabel = label ?? triggerProps?.["aria-label"] ?? "Open menu";

const mergedTriggerProps: PureButtonProps = {
  type: "button",
  // Menu trigger semantics
  "aria-haspopup": "menu",
  "aria-controls": menuId,
  "aria-expanded": "false",
  "aria-label": ariaLabel,

  // Popover API wiring
  popovertarget: menuId,
  popovertargetaction: "toggle",

  // Allow caller overrides (theme, size, icon, etc.)
  ...(triggerProps ?? {})
};
---

<style>
  /* Make the trigger an anchor */
  [data-dropdown-trigger] {
    anchor-name: --anchor;
    width: fit-content;
  }

  /* Popover positioned from trigger via Anchor Positioning */
  [data-dropdown-menu] {
    --d: 1em;
    --s: 1.2em;

    position: fixed;
    inset: auto;
    z-index: 10;

    position-anchor: --anchor;
    position-area: bottom;
    top: calc(var(--d) + 0.5rem);

    justify-self: anchor-center;
    align-self: normal;

    margin-bottom: var(--d);
    position-try: flip-block;

    max-width: 15em;
    border-radius: 1rem;
    padding: 0.5rem;
    background: #0088ff;
    color: #fff;

    anchor-name: --dropdown;
  }

  /* Arrow (optional) */
  [data-dropdown-menu]::before {
    content: "";
    position: fixed;
    z-index: -1;
    width: var(--s);
    background: inherit;

    top: calc(anchor(--dropdown top) - var(--d));
    bottom: calc(anchor(--dropdown bottom) - var(--d));
    left: calc(anchor(--anchor center) - var(--s) / 2);

    margin: inherit;

    clip-path: polygon(
      50% .2em,
      100% var(--d),
      100% calc(100% - var(--d)),
      50% calc(100% - .2em),
      0 calc(100% - var(--d)),
      0 var(--d)
    );
  }

  /* Reasonable defaults for slotted menu items */
  [data-dropdown-menu] :global([role^="menuitem"]) {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    color: inherit;
    border: 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    cursor: pointer;
  }

  [data-dropdown-menu] :global([role^="menuitem"]:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  [data-dropdown-menu] :global([role^="menuitem"][aria-disabled="true"]),
  [data-dropdown-menu] :global([role^="menuitem"]:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<div class="dropdown" data-dropdown {...rest}>
  <Button
    id={triggerId}
    data-dropdown-trigger
    {...mergedTriggerProps}
  />

  <ul
    id={menuId}
    class="dropdown__menu"
    popover="auto"
    role="menu"
    aria-labelledby={triggerId}
    data-dropdown-menu
  >
    <slot />
  </ul>
</div>



<script define:vars={{ closeOnSelect }}>
  /** @type {HTMLElement | null} */
  const root = document.currentScript?.closest?.("[data-dropdown]") ?? null;
  if (!root) return;

  /** @type {HTMLElement | null} */
  const trigger = root.querySelector("[data-dropdown-trigger]");
  /** @type {HTMLElement | null} */
  const menu = root.querySelector("[data-dropdown-menu]");
  if (!trigger || !menu) return;

  // Popover API isn’t fully typed everywhere
  const pop = /** @type {any} */ (menu);

  const isOpen = () => (menu.matches?.(":popover-open") ?? false);

  /** @returns {HTMLElement[]} */
  const getItems = () =>
    Array.from(menu.querySelectorAll('[role^="menuitem"]'))
      .map((el) => /** @type {HTMLElement} */ (el))
      .filter((el) => !el.hasAttribute("disabled") && el.getAttribute("aria-disabled") !== "true");

  /** @param {boolean} open */
  const setExpanded = (open) => {
    trigger.setAttribute("aria-expanded", String(open));
  };

  /** @param {number} focusIndex */
  const focusItem = (focusIndex) => {
    const items = getItems();
    if (!items.length) return;

    const i = Math.max(0, Math.min(focusIndex, items.length - 1));
    items[i]?.focus();
  };

  /** @param {number} focusIndex */
  const openMenu = (focusIndex = 0) => {
    if (typeof pop.showPopover === "function") pop.showPopover();
    setExpanded(true);
    focusItem(focusIndex);
  };

  const closeMenu = (returnFocus = true) => {
    if (typeof pop.hidePopover === "function") pop.hidePopover();
    setExpanded(false);
    if (returnFocus) trigger.focus();
  };

  // Sync aria-expanded + focus on open/close (covers light dismiss + click)
  menu.addEventListener("toggle", () => {
    const open = isOpen();
    setExpanded(open);

    if (open) {
      // When opened (by click or keyboard), move focus into menu
      focusItem(0);
    } else {
      // When closed, restore focus if focus was inside
      if (menu.contains(document.activeElement)) trigger.focus();
    }
  });

  // Trigger keyboard behavior (Menu Button pattern)
  trigger.addEventListener("keydown", (e) => {
    const items = getItems();
    if (!items.length) return;

    switch (e.key) {
      case "ArrowDown":
        e.preventDefault();
        openMenu(0);
        break;
      case "ArrowUp":
        e.preventDefault();
        openMenu(items.length - 1);
        break;
      case "Enter":
      case " ":
        // Let native click toggle happen; focus will move on "toggle"
        break;
      case "Escape":
        if (isOpen()) {
          e.preventDefault();
          closeMenu(true);
        }
        break;
    }
  });

  // Menu navigation (roving focus)
  menu.addEventListener("keydown", (e) => {
    const items = getItems();
    if (!items.length) return;

    const active = /** @type {HTMLElement | null} */ (document.activeElement);
    const idx = Math.max(0, items.indexOf(active ?? items[0]));

    switch (e.key) {
      case "Escape":
        e.preventDefault();
        closeMenu(true);
        break;
      case "ArrowDown":
        e.preventDefault();
        items[(idx + 1) % items.length]?.focus();
        break;
      case "ArrowUp":
        e.preventDefault();
        items[(idx - 1 + items.length) % items.length]?.focus();
        break;
      case "Home":
        e.preventDefault();
        items[0]?.focus();
        break;
      case "End":
        e.preventDefault();
        items[items.length - 1]?.focus();
        break;
      case "Tab":
        // Common menu behavior: close on Tab to restore normal tab order
        e.preventDefault();
        closeMenu(true);
        break;
      default: {
        // Optional typeahead (single-character quick nav)
        if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
          const ch = e.key.toLowerCase();
          const start = (idx + 1) % items.length;

          const labelOf = (el) =>
            (el.getAttribute("aria-label") ||
              el.textContent ||
              "")
              .trim()
              .toLowerCase();

          for (let step = 0; step < items.length; step++) {
            const i = (start + step) % items.length;
            if (labelOf(items[i]).startsWith(ch)) {
              e.preventDefault();
              items[i].focus();
              break;
            }
          }
        }
      }
    }
  });

  // Close on selection (optional)
  menu.addEventListener("click", (e) => {
    if (!closeOnSelect) return;
    const t = e.target instanceof HTMLElement ? e.target : null;
    if (t?.closest?.('[role^="menuitem"]')) closeMenu(true);
  });
</script>