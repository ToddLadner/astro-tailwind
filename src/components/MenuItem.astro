---
// MenuItem.astro
import type { HTMLAttributes } from "astro/types";
import Button, { type PureButtonProps } from "@components/Button.astro";

/**
 * Menu items can be either a <button> or an <a>.
 * Your Button.astro already supports both via `href`.
 */
type Props = HTMLAttributes<"li"> & {
  /** Render the menu item as a link when provided */
  href?: string;

  /** Button.astro props */
  itemProps?: PureButtonProps & {
    /** Allowed here even though PureButtonProps is "button-only" */
    href?: string;
  };

  /** Role variant (defaults to menuitem) */
  role?: "menuitem" | "menuitemcheckbox" | "menuitemradio";

  /** Optional label (falls back to itemProps.aria-label or text/slot) */
  label?: string;
  classes?: string;
};

const {
  href,
  itemProps,
  role = "menuitem",
  label,
  classes,
  ...rest
} = Astro.props as Props;

const mergedItemProps = {
  role,
  ...(href && { href }),
  ...(label && { "aria-label": label }),
  ...itemProps,
} as const satisfies Record<string, any>;
---

<style>
  /* Make Button look like a menuitem */
  [role^="menuitem"] {
    inline-size: 100%;
    text-align: left;
    background: transparent;
  }

  [role^="menuitem"][aria-disabled="true"],
  [role^="menuitem"]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<li role="none" class:list={[classes]} {...rest}>
  <Button {...mergedItemProps}>
    <slot />
  </Button>
</li>