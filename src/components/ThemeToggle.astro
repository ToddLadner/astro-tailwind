<style>
.theme-picker {
	border: 0;
	margin: 0;
	padding: 0;
	min-inline-size: 0;
}

.theme-picker__options {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 2px;
	padding: 3px;
	border: 1px solid var(--color-surface-4);
	border-radius: var(--radius-md);
	background: var(--color-surface-2);
	box-shadow: var(--shadow-xs);
}

.theme-picker__option {
	position: relative;
	display: grid;
	place-items: center;
	min-inline-size: 2.75rem;
	min-block-size: 2.75rem;
	padding: var(--spacing-2xs);
	border-radius: calc(var(--radius-md) - 3px);
	color: var(--color-weak);
	cursor: pointer;
	-webkit-tap-highlight-color: transparent;

	&:hover {
		color: var(--color-strong);
		background: var(--color-surface-3);
	}

	&:has(input:checked) {
		color: var(--color-strong);
		background: var(--color-surface-1);
		box-shadow: var(--shadow-sm);
	}

	&:has(input:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}
}

.theme-picker__option input {
	position: absolute;
	inline-size: 1px;
	block-size: 1px;
	opacity: 0;
	pointer-events: none;
}

.theme-picker__option svg {
	inline-size: 1.25rem;
	block-size: 1.25rem;
	fill: none;
	stroke: currentColor;
	stroke-linecap: round;
	stroke-linejoin: round;
	stroke-width: 1.8;
}

.sr-only {
	position: absolute;
	inline-size: 1px;
	block-size: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
	white-space: nowrap;
	border: 0;
}

@media (prefers-reduced-motion: no-preference) {
	.theme-picker__option {
		transition:
			color 150ms ease,
			background-color 150ms ease,
			box-shadow 150ms ease;
	}

	:root.theme-transition::view-transition-old(root),
	:root.theme-transition::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}

	:root.theme-transition::view-transition-old(root) {
		z-index: 1;
	}

	:root.theme-transition::view-transition-new(root) {
		z-index: 2;
		animation: theme-reveal 350ms ease-out;
	}
}

@keyframes theme-reveal {
	from {
		clip-path: circle(0 at var(--theme-reveal-x) var(--theme-reveal-y));
	}

	to {
		clip-path: circle(var(--theme-reveal-radius) at var(--theme-reveal-x) var(--theme-reveal-y));
	}
}
</style>

<fieldset class="theme-picker" data-theme-picker>
	<legend class="sr-only">Color theme</legend>
	<div class="theme-picker__options">
		<label class="theme-picker__option" title="Light theme">
			<input type="radio" name="theme" value="light">
			<span class="sr-only">Light</span>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<circle cx="12" cy="12" r="4"></circle>
				<path
					d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
				></path>
			</svg>
		</label>

		<label class="theme-picker__option" title="Use system theme">
			<input type="radio" name="theme" value="system">
			<span class="sr-only">System</span>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<rect x="3" y="4" width="18" height="13" rx="2"></rect>
				<path d="M8 21h8M12 17v4"></path>
			</svg>
		</label>

		<label class="theme-picker__option" title="Dark theme">
			<input type="radio" name="theme" value="dark">
			<span class="sr-only">Dark</span>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
			</svg>
		</label>
	</div>
</fieldset>

<script is:inline>
const root = document.documentElement;
const picker = document.currentScript?.previousElementSibling;

if (!(picker instanceof HTMLFieldSetElement) || !picker.matches("[data-theme-picker]")) {
	throw new Error("Theme picker not found");
}

const media = window.matchMedia("(prefers-color-scheme: dark)");
const choices = [...picker.querySelectorAll('input[name="theme"]')];
let activeTransition = null;

function isThemePreference(value) {
	return value === "light" || value === "dark" || value === "system";
}

function resolveTheme(choice) {
	return choice === "system" ? (media.matches ? "dark" : "light") : choice;
}

function commitTheme(choice, resolved, persist) {
	root.dataset.themePreference = choice;
	root.setAttribute("color-scheme", resolved);
	for (const input of choices) input.checked = input.value === choice;
	if (persist) localStorage.theme = choice;
}

function clearTransitionStyles() {
	root.classList.remove("theme-transition");
	root.style.removeProperty("--theme-reveal-x");
	root.style.removeProperty("--theme-reveal-y");
	root.style.removeProperty("--theme-reveal-radius");
}

function applyTheme(preference, { animate = false, persist = true, source } = {}) {
	const choice = isThemePreference(preference) ? preference : "system";
	const resolved = resolveTheme(choice);
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const canTransition =
		animate &&
		root.getAttribute("color-scheme") !== resolved &&
		!reducedMotion &&
		typeof document.startViewTransition === "function" &&
		source instanceof HTMLElement;

	if (!canTransition) {
		activeTransition?.skipTransition();
		commitTheme(choice, resolved, persist);
		return;
	}

	const rect = source.getBoundingClientRect();
	const x = rect.left + rect.width / 2;
	const y = rect.top + rect.height / 2;
	const radius = Math.max(
		Math.hypot(x, y),
		Math.hypot(window.innerWidth - x, y),
		Math.hypot(x, window.innerHeight - y),
		Math.hypot(window.innerWidth - x, window.innerHeight - y),
	);

	activeTransition?.skipTransition();
	clearTransitionStyles();
	root.style.setProperty("--theme-reveal-x", `${x}px`);
	root.style.setProperty("--theme-reveal-y", `${y}px`);
	root.style.setProperty("--theme-reveal-radius", `${radius}px`);
	root.classList.add("theme-transition");

	try {
		const transition = document.startViewTransition(() => commitTheme(choice, resolved, persist));
		activeTransition = transition;
		transition.finished
			.catch(() => {})
			.finally(() => {
				if (activeTransition !== transition) return;
				activeTransition = null;
				clearTransitionStyles();
			});
	} catch {
		activeTransition = null;
		clearTransitionStyles();
		commitTheme(choice, resolved, persist);
	}
}

applyTheme(root.dataset.themePreference || localStorage.theme, { persist: false });

picker.addEventListener("change", (event) => {
	if (!(event.target instanceof HTMLInputElement)) return;
	applyTheme(event.target.value, {
		animate: true,
		source: event.target.closest(".theme-picker__option"),
	});
});

media.addEventListener("change", () => {
	if (root.dataset.themePreference === "system") applyTheme("system", { persist: false });
});
</script>
