---
import { Image } from "astro:assets";
import spaceWhale from "@images/space-whale.jpg";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
	theme?: "outlined" | "tonal" | "filled";
	classes?: string;
}

const { theme, classes, ...rest } = Astro.props;
---

<style>
@layer components {
	.card {
		--bg-color: transparent;
		--border-color: transparent;
		--border-width: 0;

		background-color: var(--bg-color);
		border-color: var(--border-color);
		border-radius: var(--radius-md);
		border-style: solid;
		border-width: var(--border-width);

		/* Variants */
		&.tonal {
			--bg-color: var(--color-surface-1);
			--border-width: 1px;
		}

		&.outlined {
			--bg-color: var(--surface-default);
			--border-color: var(--border-color);
			--border-width: 1px;
		}
	}
	img {
		border-top-left-radius: inherit;
		border-top-right-radius: inherit;
	}
	h3 {
		--weight: 500;
	}
}
</style>

<article
	class:list={[
    'card',
    theme,
    classes
  ]}
	{...rest}
>
	<Image src={spaceWhale} alt="A bird sitting on a nest of eggs." />
	<div class="stack py-md px-sm">
		<slot />
	</div>
</article>
