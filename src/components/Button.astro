---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type BaseProps = {
	theme?: "outlined" | "tonal" | "filled" | "custom";
	size?: "sm" | "lg";
	elevated?: "shadow-xs" | "shadow-sm" | "shadow-md" | "shadow-lg" | "shadow-xl" | "shadow-2xl";
	shape?: "square" | "circle" | "pill" | "squircle" | "superellipse";
	variant?: "icon-button" | "bare";
	text?: string;
	icon?: string;
	classes?: string;
	disabled?: boolean;
	"aria-label"?: string;
};

type AnchorProps = BaseProps &
	Omit<HTMLAttributes<"a">, "href"> & {
		href: string;
	};

type ButtonProps = BaseProps &
	Omit<HTMLAttributes<"button">, "type"> & {
		href?: undefined;
		type?: "button" | "submit" | "reset";
	};

type Props = ButtonProps | AnchorProps;

const {
	type = "button",
	theme,
	size,
	elevated,
	variant,
	shape,
	text,
	icon,
	classes,
	href,
	disabled = false,
	"aria-label": ariaLabel,
	...rest
} = Astro.props as Props;

const isLink = typeof href === "string";
const safeHref = disabled ? undefined : href;

const classList = ["button", size, theme, shape, elevated, variant, classes];

// Export Props type for use in other components
export type ButtonPublicProps = Props;
export type PureButtonProps = ButtonProps;
---

<style>
@layer components {
	/* General Button Styles */
	:is(.button, [type="button"], [type="submit"], [type="reset"]) {
		/* Design tokens / props */
		--bg-color: transparent;
		--border-color: transparent;
		--border-width: 2px;
		--border-radius: var(--radius-md);
		--button-block-size: 2.75rem;
		--button-gap: var(--spacing-3xs);
		--button-padding-block: var(--spacing-3xs);
		--button-padding-inline: var(--spacing-2xs);
		--text-color: var(--color-brand);
		--button-ripple-duration: var(--duration-gentle-2);
		--button-ripple-size: 100%;
		--icon-size: 1em;

		/* Re-usable disabled colors (variants can override) */
		--disabled-bg: color-mix(in oklch, var(--color-strong) 8%, var(--color-surface-3));
		--disabled-text: color-mix(in oklch, var(--color-strong) 70%, var(--color-surface-3));

		/* Base button */
		min-block-size: var(--button-block-size);
		min-inline-size: var(--button-block-size);
		padding-block: var(--button-padding-block);
		padding-inline: var(--button-padding-inline);

		font-size: inherit;
		font-weight: 600;
		line-height: var(--leading-xs);
		color: var(--text-color);
		text-align: center;

		background: var(--bg-color) var(--ripple, none);
		border-radius: var(--border-radius);
		border: var(--border-width) solid var(--border-color);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--button-gap);
		vertical-align: middle;

		text-decoration: none;
		user-select: none;

		/* Disabled: shared behavior */
		&:is([disabled], [aria-disabled="true"]) {
			cursor: not-allowed;
			opacity: 0.64;
		}

		/* Non-disabled: shared behavior */
		&:where(:not([disabled], [aria-disabled="true"])) {
			cursor: pointer;
		}

		&:focus-visible {
			outline: var(--border-width) solid var(--color-brand-bright);
			outline-offset: var(--spacing-3xs);
		}

		/* Motion-OK: color & ripple */
		@media (prefers-reduced-motion: no-preference) {
			transition:
				background-color var(--duration-quick-2) var(--ease-out-3),
				box-shadow var(--duration-quick-2) var(--ease-out-3),
				border-color var(--duration-quick-2) var(--ease-out-3),
				color var(--duration-quick-2) var(--ease-out-3),
				outline-offset var(--duration-quick-1) var(--ease-1);
			background-position: center;

			&:where(:not([disabled], [aria-disabled="true"])) {
				/* Hover (ripple in) */
				&:hover {
					--ripple: radial-gradient(circle, transparent 1%, var(--bg-color) 1%) center / 15000%;
					transition: background var(--button-ripple-duration);
				}

				/* Active (ripple out) */
				&:active {
					background-size: var(--button-ripple-size);
					transition: background 0s;
					position: relative;
					top: 1px;
				}
			}
		}

		/* Motion-reduced: keep states but kill fancy ripple */
		@media (prefers-reduced-motion: reduce) {
			transition: none;
			background-position: center;

			&:where(:not([disabled], [aria-disabled="true"])) {
				&:hover,
				&:active {
					--ripple: none;
				}
			}
		}

		/* Brand-based default hover / active backgrounds */
		&:where(:not([disabled], [aria-disabled="true"])) {
			/* Hover (not pressed) */
			&:hover:not(:active) {
				--bg-color: light-dark(
					oklch(from var(--color-brand) l 0.01 h / 15%),
					oklch(from var(--color-brand) l 0.01 h / 10%)
				);
			}

			/* Pressed */
			&:active {
				--bg-color: light-dark(
					oklch(from var(--color-brand) l 0.06 h / 20%),
					oklch(from var(--color-brand) l 0.06 h / 10%)
				);
			}
		}

		/* Disabled text color (base) */
		&:is([disabled], [aria-disabled="true"]) {
			--text-color: color-mix(in oklch, var(--color-weak) 90%, var(--color-surface-1));
		}

		/* Button with icon + text */
		&:not(.icon-button) {
			[data-icon] {
				block-size: var(--icon-size);
				inline-size: var(--icon-size);
				flex: none;
				color: currentColor;
			}
		}

		/* Size variants */
		&.sm {
			--button-padding-inline: var(--spacing-3xs);
		}
		&.lg {
			--button-block-size: 3rem;
			--button-padding-inline: var(--spacing-xs);
		}

		/* Icon button variant */
		&.icon-button {
			inline-size: var(--button-block-size);
			padding: var(--button-padding-block);
			aspect-ratio: var(--aspect-square);

			[data-icon] {
				block-size: var(--icon-size);
				inline-size: var(--icon-size);
			}
		}

		/* The global elevation scale starts at sm; keep the public xs option useful. */
		&.shadow-xs {
			box-shadow: 0 1px 2px hsl(var(--shadow-color) / calc(var(--shadow-strength) + 4%));
		}

		/* =========================
        VARIANTS
        ========================= */

		/* OUTLINED */
		&.outlined {
			--bg-color: var(--color-surface-a04);
			--border-color: var(--color-brand);
			--text-color: var(--color-brand);

			&:where(:not([disabled], [aria-disabled="true"])) {
				/* Hover */
				&:hover {
					--bg-color: var(--color-brand-7);
					--border-color: var(--color-brand-7);
					--text-color: var(--color-strong-dark);
				}

				/* Active (pressed) */
				&:active {
					--bg-color: light-dark(
						oklch(from var(--color-brand) calc(l + 0.1) c h / 100%),
						oklch(from var(--color-brand) calc(l - 0.1) c h / 100%)
					);
					--border-color: light-dark(
						oklch(from var(--color-brand) calc(l + 0.1) c h / 100%),
						oklch(from var(--color-brand) calc(l - 0.1) c h / 100%)
					);
					--text-color: var(--color-gray-0);
				}
			}

			/* Outlined – disabled colors */
			&:is([disabled], [aria-disabled="true"]) {
				--bg-color: transparent;
				--border-color: color-mix(in oklch, var(--color-strong) 50%, var(--color-purple-1));
				--text-color: color-mix(in oklch, var(--color-strong) 70%, var(--color-surface-1));
			}
		}

		/* TONAL */
		&.tonal {
			--bg-color: light-dark(
				oklch(from var(--color-brand) 80% 0.12 h / 100%),
				oklch(from var(--color-brand) l c h / 100%)
			);
			--text-color: var(--color-purple-13);

			&:where(:not([disabled], [aria-disabled="true"])) {
				/* Hover */
				&:hover {
					--bg-color: light-dark(
						oklch(from var(--color-brand) 85% 0.12 h / 100%),
						oklch(from var(--color-brand) 65% c h / 100%)
					);
					--border-color: light-dark(
						oklch(from var(--color-brand) 85% 0.12 h / 100%),
						oklch(from var(--color-brand) 65% c h / 100%)
					);
				}

				/* Active */
				&:active {
					--bg-color: light-dark(
						oklch(from var(--color-brand) 90% 0.12 h / 100%),
						oklch(from var(--color-brand) 70% c h / 100%)
					);
					--border-color: light-dark(
						oklch(from var(--color-brand) 90% 0.12 h / 100%),
						oklch(from var(--color-brand) 70% c h / 100%)
					);
				}
			}

			/* Tonal – disabled */
			&:is([disabled], [aria-disabled="true"]) {
				--bg-color: var(--disabled-bg);
				--text-color: var(--disabled-text);
			}
		}

		/* FILLED */
		&.filled {
			--bg-color: var(--color-brand);
			--text-color: var(--color-gray-1);

			&:where(:not([disabled], [aria-disabled="true"])) {
				/* Hover */
				&:hover {
					--bg-color: var(--color-brand-7);
					--border-color: var(--color-brand-7);
				}

				/* Active */
				&:active {
					--bg-color: var(--color-brand-9);
					--border-color: var(--color-brand-9);
				}
			}

			/* Filled – disabled */
			&:is([disabled], [aria-disabled="true"]) {
				--bg-color: color-mix(in oklch, var(--color-weak) 20%, var(--color-surface-2));
				--text-color: color-mix(in oklch, var(--color-weak) 85%, var(--color-surface-2));
			}
		}

		/* CUSTOM */
		&.custom {
			--bg-color: light-dark(
				color-mix(in oklab, var(--color-brand) 20%, var(--color-gray-1)),
				color-mix(in oklab, var(--color-brand) 10%, var(--color-gray-10))
			);
			--ripple-color: light-dark(
				color-mix(in oklch, var(--color-gray-1) 80%, var(--color-purple-15)),
				color-mix(in oklch, var(--color-gray-13) 80%, var(--color-purple-1))
			);
			--text-color: light-dark(var(--color-purple-9), var(--color-purple-2));

			&:where(:not([disabled], [aria-disabled="true"])) {
				/* Hover */
				&:hover {
					--ripple: radial-gradient(circle, transparent 1%, var(--ripple-color) 1%) center / 15000%;

					--bg-color: light-dark(
						color-mix(in oklch, var(--color-gray-2) 93%, var(--color-purple-8)),
						color-mix(in oklch, var(--color-gray-13) 93%, var(--color-purple-8))
					);
				}

				/* Active */
				&:active {
					--bg-color: light-dark(
						color-mix(in oklch, var(--color-gray-2) 91%, var(--color-purple-8)),
						color-mix(in oklch, var(--color-gray-13) 91%, var(--color-purple-8))
					);
				}
			}

			/* Custom – disabled */
			&:is([disabled], [aria-disabled="true"]) {
				--bg-color: var(--disabled-bg);
				--text-color: var(--disabled-text);
			}
		}

		/* Bare */
		&.bare {
			--bg-color: transparent;
			min-block-size: 0;
			min-inline-size: 0;
			inline-size: auto;
			display: grid;
			margin: 0;
			padding: 0;
		}
	}
}

/* Scoped component styles can load before the global layer-order declaration. */
:is(.button.sm) {
	font-size: var(--text-xs);
}

:is(.button.lg) {
	font-size: var(--text-lg);
}

/* Spring interaction helper */
.spring {
	transition:
		transform 1s var(--ease-spring-5),
		box-shadow 1s var(--ease-spring-5),
		outline-offset 145ms var(--ease-4);

	&:active {
		transform: scale(0.9);
	}
}

@media (prefers-reduced-motion: reduce) {
	.spring {
		transition: none;

		&:active {
			transform: none;
		}
	}
}
</style>

{isLink ? (
  <a
    {...rest}
    href={safeHref}
    aria-disabled={disabled ? "true" : undefined}
    tabindex={disabled ? -1 : undefined}
    inert={disabled ? true : undefined}
    aria-label={ariaLabel}
    class:list={classList}
  >
    { icon && <Icon name={icon} data-icon /> }
    <slot />
    {text}
  </a>
) : (
  <button
    {...rest}
    type={type as "button" | "submit" | "reset"}
    aria-label={ariaLabel}
    class:list={classList}
    disabled={disabled}
  >
    { icon && <Icon name={icon} data-icon /> }
    <slot />
    {text}
  </button>
)}
